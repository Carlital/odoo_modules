<odoo>
    <record id="view_crm_lead_form_inherit" model="ir.ui.view">
        <field name="name">crm.lead.form.inherit.whatsapp</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="mark_as_interested" string="Mark as Interested" type="object" class="oe_highlight"/>
                <button name="send_whatsapp_message" string="Send WhatsApp Message" type="object" class="btn-primary"/>
            </xpath>
        </field>
    </record>
</odoo>
