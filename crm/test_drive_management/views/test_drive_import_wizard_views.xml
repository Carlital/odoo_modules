<odoo>
    <record id="view_test_drive_import_wizard_form" model="ir.ui.view">
        <field name="name">test.drive.import.wizard.form</field>
        <field name="model">test.drive.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Import Test Drive Schedule">
                <group>
                    <field name="file" filename="filename"/>
                </group>
                <footer>
                    <button string="Import" type="object" name="import_file" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    
    <record id="action_test_drive_import_wizard" model="ir.actions.act_window">
        <field name="name">Import Test Drive Schedule</field>
        <field name="res_model">test.drive.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
    
    <menuitem id="menu_test_drive_import_wizard" name="Import Test Drive Schedule" parent="menu_test_drive_management" action="action_test_drive_import_wizard" sequence="20"/>
</odoo>
