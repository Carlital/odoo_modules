<odoo>
	<data>
		<record id="ir_cron_scheduler_product_cache_notification" model="ir.cron">
			<field name="name">Sync Product In Backend</field>
			<field eval="True" name="active" />
			<field name="user_id" ref="base.user_root"/>
			<field name="interval_number">12</field>
			<field name="interval_type">hours</field>
			<field ref="model_mongo_server_config" name="model_id"/>
			<field name="state">code</field>
			<field name="code">model.with_context(from_cron=True).sync_products()</field>
		</record>

		<record id="ir_cron_scheduler_partner_cache_notification" model="ir.cron">
			<field name="name">Sync Partners In Backend</field>
			<field eval="True" name="active" />
			<field name="user_id" ref="base.user_root"/>
			<field name="interval_number">12</field>
			<field name="interval_type">hours</field>
			<field ref="model_mongo_server_config" name="model_id"/>
			<field name="state">code</field>
			<field name="code">model.with_context(from_cron=True).sync_partners()</field>
		</record>

		<record id="cron_records_sync" model="ir.cron">
			<field name="name">Partner and Product Sync</field>
			<field name="model_id" ref="model_mongo_server_config"/>
			<field name="state">code</field>
			<field name="code">model.cron_sync_records()</field>
			<field name="interval_number">1</field>
			<field name="interval_type">minutes</field>
			<field name="active">True</field>
		</record>
	</data>
</odoo>
