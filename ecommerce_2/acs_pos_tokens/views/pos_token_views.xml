<odoo>
    <!-- Acción (si no la tenías aún) -->
    <record id="action_pos_token" model="ir.actions.act_window">
        <field name="name">Tokens POS</field>
        <field name="res_model">pos.token</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Vista árbol decorada -->
    <record id="view_pos_token_list" model="ir.ui.view">
        <field name="name">pos.token.list</field>
        <field name="model">pos.token</field>
        <field name="arch" type="xml">
            <list decoration-danger="not active" decoration-success="active">
                <field name="token"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- Vista formulario -->
    <record id="view_pos_token_form" model="ir.ui.view">
        <field name="name">pos.token.form</field>
        <field name="model">pos.token</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group style="width: 300px;">
                            <field name="token" readonly="1" widget="CopyClipboardChar"/>
                        </group>
                    </group>
                    <group>
                        
                        <field name="date_start" readonly="state == 'confirmed'"/>
                        <field name="date_end" readonly="state == 'confirmed'"/>
                        <field name="create_uid" readonly="1"/>
                        <field name="active" readonly="1" invisible="1"/>
                    </group>

                    <group string="Permisos POS">
                        <field name="permitir_todo" readonly="state == 'confirmed'" invisible="1"/>
                        <field name="entrada_salida" readonly="state == 'confirmed'"/>
                        <field name="ordenes" readonly="state == 'confirmed'"/>
                        <field name="pricelist" readonly="state == 'confirmed'"/>
                        <field name="discount" readonly="state == 'confirmed'"/>
                        <field name="refund" readonly="state == 'confirmed'"/>
                        <field name="cerrar_caja" readonly="state == 'confirmed'"/>
                        
                        <field name="product_ids" widget="many2many_tags"/>
                        
                    </group>

                    <notebook>
                        <page name="history" string="Historial">
                            <field name="users_use_ids" readonly="1">
                                <list>
                                    <field name="user_id"/>
                                    <field name="accion"/>
                                    <field name="use_date"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Filtro (búsqueda) -->
    <record id="view_pos_token_search" model="ir.ui.view">
        <field name="name">pos.token.search</field>
        <field name="model">pos.token</field>
        <field name="arch" type="xml">
            <search>
                <field name="token"/>
                <filter name="filter_active" string="Activos" domain="[('active','=',True)]"/>
                <filter name="filter_inactive" string="Inactivos" domain="[('active','=',False)]"/>
            </search>
        </field>
    </record>
</odoo>
