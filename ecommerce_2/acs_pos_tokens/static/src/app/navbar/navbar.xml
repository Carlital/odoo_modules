<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="Navbar" t-inherit="point_of_sale.Navbar" t-inherit-mode="extension" owl="1">
        <!-- Eliminar el botón "Create Product" -->
        <xpath expr="//DropdownItem[@t-if='showCreateProductButton']" position="replace"/>
    </t>

    <t t-name="ClosePosPopup" t-inherit="point_of_sale.ClosePosPopup" t-inherit-mode="extension" owl="1">
        <!-- Eliminar el botón "Create Product" -->
        <xpath expr="//button[@t-on-click='() => this.cashMove()']" position="replace">
            <!-- <button class="button btn btn-secondary" t-att-class="this.ui.isSmall ? 'w-100' : 'btn-lg'" t-on-click="() => this.cashMove()">Cash In/Out</button> -->
        </xpath>
    </t>
    
</templates>
