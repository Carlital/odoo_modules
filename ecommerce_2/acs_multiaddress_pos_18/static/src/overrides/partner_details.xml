<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="acs_multiaddress_pos_18.PartnerDetails" t-inherit="point_of_sale.PartnerLine" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('partner-detail')]" position="after">
            <t t-if="props.partner.other">
                <div class="partner-detail">
                    <span class="label">Otros:</span>
                    <span class="detail"><t t-esc="props.partner.other"/></span>
                </div>
            </t>

            <t t-if="props.partner.address_array and props.partner.address_array.length">
                <div class="partner-detail">
                    <span class="label">Direcciones Adicionales:</span>
                    <div class="detail">
                        <t t-foreach="props.partner.address_array" t-as="address" t-key="address.id">
                            <div class="text-muted small">
                                <t t-esc="address.address"/>
                            </div>
                        </t>
                    </div>
                </div>
            </t>
        </xpath>
    </t>
</templates>
