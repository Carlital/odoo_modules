<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_product_template_form_inherit" model="ir.ui.view">
        <field name="name">product.template.form.inherit</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view" />
        <field name="arch" type="xml">

            <!-- Añadir campos en la pestaña general -->
            <xpath expr="//page[@name='general_information']/group" position="inside">
                <!-- Campos Stock Secundario y Relación -->
                <group string="Stock Alternativo">
                    <field name="secondary_uom_id" />
                    <field name="secondary_stock" />
                    <field name="conversion_ratio" readonly="1" />
                </group>

            </xpath>

        </field>
    </record>

</odoo>