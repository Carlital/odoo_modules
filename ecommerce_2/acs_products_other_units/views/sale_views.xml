<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_inherit" model="ir.ui.view">
        <field name="name">sale.order.form.inherit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/list//field[@name='tax_id']"
                position="after">
                <field name="conversion_ratio" column_invisible="True" />
                <field name="secondary_qty" optional="show" />
                <field name="secondary_uom_id" optional="show" options="{'no_open': True}" />
            </xpath>
        </field>
    </record>
</odoo>