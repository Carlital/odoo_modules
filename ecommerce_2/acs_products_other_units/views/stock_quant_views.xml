<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Vista Tree para stock.quant -->
    <record id="view_stock_quant_tree_inherit" model="ir.ui.view">
        <field name="name">stock.quant.tree.inherit</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.view_stock_quant_tree" />
        <field name="arch" type="xml">

            <!-- Añadir las columnas después del campo product_uom_id -->
            <xpath expr="//field[@name='product_uom_id']" position="after">
                <field name="secondary_uom_id" string="UoM Secundario" optional="hide" />
                <field name="conversion_ratio" string="Ratio Conversión" optional="hide" />
                <field name="secondary_stock" string="Stock Secundario" optional="show"
                    sum="Total Stock Secundario" />
            </xpath>

        </field>
    </record>

    <!-- Vista Tree Editable para stock.quant (si existe) -->
    <record id="view_stock_quant_tree_editable_inherit" model="ir.ui.view">
        <field name="name">stock.quant.tree.editable.inherit</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.view_stock_quant_tree_editable" />
        <field name="arch" type="xml">

            <!-- Añadir las columnas después del campo product_uom_id -->
            <xpath expr="//field[@name='product_uom_id']" position="after">
                <field name="secondary_uom_id" string="UoM Secundario" optional="hide" />
                <field name="conversion_ratio" string="Ratio Conversión" optional="hide" />
                <field name="secondary_stock" string="Stock Secundario" optional="show"
                    sum="Total Stock Secundario" />
            </xpath>

        </field>
    </record>

</odoo>