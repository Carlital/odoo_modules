<odoo>
    <record id="view_mrp_production_components_list_inherit_available_lot" model="ir.ui.view">
        <field name="name">mrp.production.components.list.inherit.available.lot</field>
        <field name="model">stock.move</field>
        <field name="inherit_id" ref="mrp.view_mrp_stock_move_operations" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_id']" position="before">
                <field name="available_lot_id" widget="many2one" string="Buscar Lote/Serie"
                    options="{'no_create': True}"
                />
            </xpath>
        </field>
    </record>

    <record id="view_mrp_production_form_inherit_available_lot" model="ir.ui.view">
        <field name="name">mrp.production.form.inherit.available.lot</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='move_raw_ids']/list/field[@name='product_id']"
                position="before">
                <field name="available_lot_id" widget="many2one" string="Buscar Lote/Serie"
                    options="{'no_create': True}"
                    column_invisible="parent.state not in ('draft','confirmed')" />
            </xpath>
        </field>
    </record>
</odoo>