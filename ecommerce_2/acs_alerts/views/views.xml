<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>

    <record id="mail_alert_view_form" model="ir.ui.view">
      <field name="name">mail.alert.view.form</field>
      <field name="model">mail.alert</field>
      <field name="arch" type="xml">
        <form string="">
          <header>
            <button name="send_alert" invisible="sent == True" string="Enviar alerta" type="object"
              class="oe_highlight" />
            <button name="send_alert" invisible="sent == False" string="Reenviar alerta"
              type="object" class="oe_highlight" />
            <field name="state" widget="statusbar" />
          </header>
          <sheet>
            <group>
              <field name="name" />
              <field name="sent" invisible="1" />
              <field name="date" />
              <field name="destinatarios_ids" widget="many2many_tags" />
              <field name="message_body" />
            </group>
          </sheet>
        </form>
      </field>
    </record>

    <record id="mail_alert_view_list" model="ir.ui.view">
      <field name="name">mail.alert.view.list</field>
      <field name="model">mail.alert</field>
      <field name="arch" type="xml">
        <list>
          <field name="name" />
          <field name="date" />
          <field name="destinatarios_ids" widget="many2many_tags" />
          <field name="state" />
        </list>
      </field>
    </record>

    <record id="action_view_mail_alert" model="ir.actions.act_window">
      <field name="name">Alerts</field>
      <field name="res_model">mail.alert</field>
      <field name="view_mode">list,form</field>
    </record>

    <menuitem
      name="Enviar Alertas"
      id="acs_alerts"
      parent="mail.menu_root_discuss"
      action="action_view_mail_alert"
      groups="group_send_alerts" />

  </data>
</odoo>