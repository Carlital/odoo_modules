<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="list_price_purchase_wizard_form" model="ir.ui.view">
        <field name="name">list.price.purchase.wizard.form</field>
        <field name="model">list.price.purchase.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <group>
                        <field name="msg"/>
                        <field name="product_standard_name" readonly="1"/>
                        <field name="product_id"/>
                        <field name="show_previus" invisible="1"/>
                        <field name="show_next" invisible="1"/>
                        <field name="this_update" invisible="1"/>
                    </group>
                    <group>
                        <field name="profit_percentage_pu" string="% P.U." readonly="1"/>
                        <field name="profit_percentage_pm" string="% P.M." readonly="1"/>
                        <field name="profit_percentage_pc" string="% P.C." readonly="1"/>
                        <field name="data_ids" invisible="1"/>
                    </group>
                    <group>
                        <field name="standard_price"/>
                        <field name="line_id" invisible="1"/>
                    </group>
                    <group>
                        <field name="order_price"/>
                    </group>
                </group>
                <field name="line_ids" nolabel="1">
                    <list editable="bottom" create="0" delete="0">
                        <field name="name" readonly="1" />
                        <field name="nickname"/>
                        <field name="pricelist_id" readonly="1" column_invisible="1"/>
                        <field name="pricelist_item_id" readonly="1" column_invisible="1"/>
                        <field name="is_cajon" column_invisible="1"/>
                        <field name="min_quantity" readonly="not is_cajon" string="Cant. Mínima"/>
                        <field name="margin" readonly="1" class="text-danger"/>
                        <field name="price" readonly="1" class="text-danger"/>
                        <field name="margin2" readonly="0" required="1" class="text-info" context="{'margin2': True}"/>
                        <field name="price2" readonly="0" required="1" class="text-info" context="{'price2': True}"/>
                    </list>
                </field>

                <field name="variation_price_integer" invisible="1"/>
                <h5 style="color:blue;" invisible="variation_price_integer != 2">
                    Variación de precio + <field name="variation_price" readonly="1"/>
                </h5>
                <h5 style="color:red;" invisible="variation_price_integer != 0">
                    Variación de precio <field name="variation_price" readonly="1"/>
                </h5>
                <h5 style="color:black;" invisible="variation_price_integer != 1">
                    Variación de precio <field name="variation_price" readonly="1"/>
                </h5>
                <footer>
                    <button string='Anterior' name="call_previus" type="object" class="btn-primary" invisible="show_previus == False"/>
                    <button string='Actualizar' name="update_wizard" type="object" class="btn-primary"/>
                    <button string='Siguiente' name="call_next" type="object" class="btn-primary" invisible="show_next == False"/>
                    <button string="Cancelar" class="btn-default" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="list_price_purchase_wizard_action" model="ir.actions.act_window">
        <field name="name">Lista de precios</field>
        <field name="res_model">list.price.purchase.wizard</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="list_price_purchase_wizard_form"/>
        <field name="target">new</field>
    </record>

    <record id="product_pricelist_view_form_inherit_acs" model="ir.ui.view">
        <field name="name">product.pricelist.form.inherit.acs</field>
        <field name="model">product.pricelist</field>
        <field name="inherit_id" ref="product.product_pricelist_view"/>
        <field name="arch" type="xml">
            <field name="currency_id" position="after">
                <field name="is_main"/>
                <field name="is_cajon"/>
            </field>
            <xpath expr="//field[@name='item_ids']/list/field[@name='name']" position="before">
                <field name="nickname"/>
            </xpath>
        </field>
    </record>

    <record id="product_pricelist_item_tree_view_inherit_acs" model="ir.ui.view">
        <field name="name">product.pricelist.item.list.inherit.acs</field>
        <field name="model">product.pricelist.item</field>
        <field name="inherit_id" ref="product.product_pricelist_item_tree_view_from_product"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='fixed_price']" position="before">
                <field name="nickname"/>
            </xpath>
        </field>
    </record>

    <record id="product_pricelist_item_form_view_inherit_acs" model="ir.ui.view">
        <field name="name">product.pricelist.item.form.inherit.acs</field>
        <field name="model">product.pricelist.item</field>
        <field name="inherit_id" ref="product.product_pricelist_item_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='display_applied_on']" position="before">
                <field name="nickname"/>
            </xpath>
        </field>
    </record>

</odoo>
