<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="acs_purchase_default_code" model="ir.ui.view">
        <field name="name">acs.purchase.default.code</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <field name="default_code" position="attributes">
                <attribute name="string">Código Sunat</attribute>
            </field>
            <field name="default_code" position="after">
                <field name="equal_wholesale_import_price"/>
            </field>
        </field>
    </record>

    <record id="acs_purchase_default_code_product" model="ir.ui.view">
        <field name="name">acs.purchase.default.code.product</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <field name="default_code" position="attributes">
                <attribute name="string">Código Sunat</attribute>
            </field>
            <field name="default_code" position="after">
                <field name="equal_wholesale_import_price"/>
            </field>
        </field>
    </record>

</odoo>
