<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Definir el formato de papel personalizado -->
        <record id="paperformat_sale_order" model="report.paperformat">
            <field name="name">Formato Cotización o Pedido</field>
            <field name="default" eval="False" />
            <field name="format">A4</field>
            <field name="orientation">Portrait</field>
            <field name="margin_top">7</field>
            <field name="margin_bottom">12</field>
            <field name="margin_left">7</field>
            <field name="margin_right">7</field>
            <field name="header_line" eval="False" />
            <field name="header_spacing">3</field>
        </record>
        <!-- Vincular el formato de papel al informe Cotización en PDF -->
        <record id="sale.action_report_saleorder" model="ir.actions.report">
            <field name="paperformat_id" ref="acs_sale_report.paperformat_sale_order" />
        </record>
        <!-- Vincular el formato de papel al informe Cotización/orden -->
        <record id="sale_pdf_quote_builder.action_report_saleorder_raw" model="ir.actions.report">
            <field name="paperformat_id" ref="acs_sale_report.paperformat_sale_order" />
        </record>
        <!-- Plantilla del informe -->
        <template id="report_saleorder_document_inherit" inherit_id="sale.report_saleorder_document">
            <xpath expr="//t[@t-name='sale.report_saleorder_document']" position="replace">
                <t t-name="sale.report_saleorder_document">
                    <t t-call="web.html_container">
                        <t t-foreach="docs" t-as="doc">
                            <!-- Forzar el idioma a es_PE -->
                            <t t-set="doc" t-value="doc.with_context(lang='es_PE')"/>
                            <t t-call="web.basic_layout">
                                <style>
                            *{
                            font-family: arial !important;
                            }
                            table.table-client td{
                            padding: 2px!important; font-size: 15px !important
                            }
                            table.table-client td &gt; strong{
                            padding-right: 2px !important
                            }
                            table.table-striped tbody tr:nth-of-type(odd) {
                            background-color: rgba(0, 0, 0, .05);
                            }
                            table.table-banks{
                            width:100%; border:0px!important; border-collapse: collapse;
                            }
                            table.table-banks thead, table.table-banks tbody{
                            border:0px!important
                            }
                            table.table-banks thead tr{
                            border:1px solid #000 !important;background:#000;height: 30px
                            !important;
                            }
                            table.table-banks thead th{
                            color:#fff;text-align:center;vertical-align: middle
                            }
                            table.table-banks tbody tr{
                            border:0px !important; border-bottom:1px dashed !important;height: 30px
                            !important
                            }
                            table.table-banks tbody tr td{
                            border:0px!important;vertical-align: middle
                            }
                            table.table-products tbody *{
                            font-size: 14px
                            }
                        </style>
                                <div class="page">
                                    <!-- Encabezado personalizado -->
                                    <table style="width:100%; border:0px!important;border-collapse: collapse;">
                                        <tbody style="border:0px!important">
                                            <tr style="border:0px!important">
                                                <td style="width:25%;vertical-align: top;border:0px!important">
                                                    <t t-if="doc.company_id.logo">
                                                        <img t-att-src="image_data_uri(doc.company_id.logo)" style="height: 50px; vertical-align: middle;"/>
                                                    </t>
                                                </td>
                                                <td style="width:45%;text-align:center;vertical-align: top;border:0px!important">
                                                    <h5 style="padding-bottom:0px;margin-bottom:0px">
                                                        <t t-esc="doc.company_id.name" />
                                                    </h5>
                                                    R.U.C.:
                                                    <t t-esc="doc.company_id.vat" />
                                                    <br />
                                                    <span style="padding-top:0px;margin-top:0px;font-size:13px">
                                                        <t t-esc="doc.company_id.street" />-
                                                        <t t-esc="doc.company_id.city" />,
                                                        <t t-esc="doc.company_id.state_id.name" />,
                                                        <t t-esc="doc.company_id.country_id.name" />
                                                        <br />
                                                        Teléfono:
                                                        <t t-esc="doc.company_id.phone" />
                                                        | E-mail:
                                                        <t t-esc="doc.company_id.email" />
                                                    </span>
                                                </td>
                                                <td style="width:30%;text-align:center;vertical-align: top;border:0px!important">
                                                    <h4>
                                                        <t t-if="doc.state == 'sale'"> PEDIDO
                                                            <br />
                                                        </t>
                                                        <t t-if="doc.state in ('draft', 'sent')"> COTIZACIÓN
                                                            <br />
                                                        </t>
                                                        <t t-if="doc.state == 'cancel'"> NOTA ANULADA
                                                            <br />
                                                        </t>
                                                        Nº
                                                        <t t-esc="doc.name" />
                                                    </h4>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                    <!-- Client Information -->
                                    <table class="table-client" style="width:100%; border:0px!important;border-collapse: collapse;">
                                        <tbody style="border:0px!important">
                                            <tr style="border:0px!important">
                                                <td style="border:0px!important;width:100px">
                                                    <strong>CLIENTE:</strong>
                                                </td>
                                                <td style="border:0px!important">
                                                    <t t-esc="doc.partner_id.name" />
                                                </td>
                                                <td class="text-end" style="border:0px!important">
                                                    <t t-if="doc.partner_id.phone or doc.partner_id.mobile">
                                                        <strong>TELF/CEL:</strong>
                                                    </t>
                                                </td>
                                                <td style="border:0px!important">
                                                    <t t-if="doc.partner_id.phone or doc.partner_id.mobile">
                                                        <t t-if="doc.partner_id.phone">
                                                            <t t-esc="doc.partner_id.phone" />
                                                        </t>
                                                        <t t-if="doc.partner_id.phone and doc.partner_id.mobile">
                                                -
                                                            <t t-esc="doc.partner_id.mobile" />
                                                        </t>
                                                        <t t-if="not doc.partner_id.phone and doc.partner_id.mobile">
                                                            <t t-esc="doc.partner_id.mobile" />
                                                        </t>
                                                    </t>
                                                </td>
                                                <td class="text-end" style="border:0px!important">
                                                    <strong>FECHA:</strong>
                                                </td>
                                                <td style="border:0px!important">
                                                    <t t-esc="doc.date_order.strftime('%d/%m/%Y')" />
                                                </td>
                                            </tr>
                                            <tr style="border:0px!important">
                                                <td style="border:0px!important">
                                                    <strong>DIRECCIÓN:</strong>
                                                </td>
                                                <td colspan="3" style="border:0px!important">
                                                    <t t-esc="doc.partner_id.street" /> -
                                                    <t t-esc="doc.partner_id.l10n_pe_district.name" />,
                                                    <t t-esc="doc.partner_id.city_id.name" />,
                                                    <t t-esc="doc.partner_id.state_id.name" />
                                                </td>
                                                <td class="text-end" style="border:0px!important">
                                                    <strong>F. VENC:</strong>
                                                </td>
                                                <td style="border:0px!important">
                                                    <t t-esc="doc.validity_date.strftime('%d/%m/%Y') if doc.validity_date else ''" />
                                                </td>
                                            </tr>
                                            <tr style="border:0px!important">
                                                <td style="border:0px!important">
                                                    <strong>RUC/DNI:</strong>
                                                </td>
                                                <td style="border:0px!important">
                                                    <t t-esc="doc.partner_id.vat" />
                                                </td>
                                                <td class="text-end" style="border:0px!important">
                                                    <t t-if="doc.client_order_ref">
                                                        <strong>O.C:</strong>
                                                    </t>
                                                </td>
                                                <td style="border:0px!important">
                                                    <t t-if="doc.client_order_ref">
                                                        <t t-esc="doc.client_order_ref" />
                                                    </t>
                                                </td>
                                                <td class="text-end" style="border:0px!important">
                                                    <t t-if="doc.payment_term_id">
                                                        <strong>COND. PAGO:</strong>
                                                    </t>
                                                </td>
                                                <td style="border:0px!important">
                                                    <t t-if="doc.payment_term_id">
                                                        <t t-esc="doc.payment_term_id.name" />
                                                    </t>
                                                </td>
                                            </tr>
                                            <tr style="border:0px!important">
                                                <td style="border:0px!important">
                                                    <t t-if="doc.user_id">
                                                        <strong>VENDEDOR:</strong>
                                                    </t>
                                                </td>
                                                <td style="border:0px!important">
                                                    <t t-if="doc.user_id">
                                                        <t t-esc="doc.user_id.name" />
                                                    </t>
                                                    <t t-if="doc.user_id.mobile"> - CEL:
                                                        <t t-esc="doc.user_id.mobile" />
                                                    </t>
                                                </td>
                                                <td style="border:0px!important">

                                                </td>
                                                <td style="border:0px!important">

                                                </td>
                                                <td class="text-end" style="border:0px!important">
                                                    <strong>MONEDA:</strong>
                                                </td>
                                                <td style="border:0px!important">
                                                    <t t-esc="doc.currency_id.name" />
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                    <!-- Products Table -->
                                    <table class="table table-bordered table-products table-striped">
                                        <thead>
                                            <tr>
                                                <th style="width: 20px">N°</th>
                                                <th>Descripción</th>
                                                <th style="width: 30px">Cant.</th>
                                                <th style="width: 40px">U.M.</th>
                                                <th style="width: 45px">P.U.</th>
                                                <t t-if="doc.company_id.hide_col_discount == False">
                                                    <th style="width: 50px"
                                                        t-if="doc.order_line.filtered(lambda line: line.discount &gt; 0)">
                                                    Dcto(%)
                                                    </th>
                                                </t>
                                                <th style="width: 60px">Importe</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-set="item" t-value="0" />
                                            <tr t-foreach="doc.order_line" t-as="line">
                                                <td class="text-center">
                                                    <t t-set="item" t-value="item + 1" />
                                                    <span t-esc="item" />
                                                </td>
                                                <td t-esc="line.name" />
                                                <td class="text-end" t-esc="line.product_uom_qty" />
                                                <td class="text-end" t-esc="line.product_uom.name" />
                                                <td class="text-end">
                                                    <t t-if="doc.company_id.hide_col_discount == False">
                                                        <span t-field="line.price_unit"
                                                        t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: doc.currency_id}" />
                                                    </t>
                                                    <t t-if="doc.company_id.hide_col_discount == True">
                                                        <span t-field="line.sale_order_line_pdesc"
                                                        t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: doc.currency_id}" />
                                                    </t>
                                                </td>
                                                <t t-if="doc.company_id.hide_col_discount == False">
                                                    <td class="text-end"
                                                    t-if="doc.order_line.filtered(lambda line: line.discount &gt; 0)"
                                                    t-esc="line.discount" />
                                                </t>
                                                <td class="text-end">
                                                    <t t-if="doc.company_id.hide_col_line_total == False">
                                                        <span t-field="line.price_total"
                                                        t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: doc.currency_id}" />
                                                    </t>
                                                    <t t-if="doc.company_id.hide_col_line_total == True">
                                                        <span t-field="line.price_subtotal"
                                                        t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: doc.currency_id}" />
                                                    </t>
                                                </td>
                                            </tr>
                                            <tr
                                                t-if="not doc.order_line.filtered(lambda line: line.discount &gt; 0)">
                                                <td colspan="5" class="text-end">
                                                    <strong>TOTAL:</strong>
                                                </td>
                                                <td class="text-end">
                                                    <t t-if="doc.company_id.hide_col_line_total == False">
                                                        <span t-field="doc.amount_total"
                                                        t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: doc.currency_id}" />
                                                    </t>
                                                    <t t-if="doc.company_id.hide_col_line_total == True">
                                                        <span t-field="doc.amount_untaxed"
                                                        t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: doc.currency_id}" />
                                                    </t>
                                                </td>
                                            </tr>
                                            <tr
                                                t-if="doc.order_line.filtered(lambda line: line.discount &gt; 0)">
                                                <t t-if="doc.company_id.hide_col_discount == False">
                                                    <td colspan="6" class="text-end">
                                                        <strong>TOTAL:</strong>
                                                    </td>
                                                    <td class="text-end">
                                                        <t t-if="doc.company_id.hide_col_line_total == False">
                                                            <span t-field="doc.amount_total"
                                                        t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: doc.currency_id}" />
                                                        </t>
                                                        <t t-if="doc.company_id.hide_col_line_total == True">
                                                            <span t-field="doc.amount_untaxed"
                                                        t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: doc.currency_id}" />
                                                        </t>
                                                    </td>
                                                </t>
                                                <t t-if="doc.company_id.hide_col_discount == True">
                                                    <td colspan="5" class="text-end">
                                                        <strong>TOTAL:</strong>
                                                    </td>
                                                    <td class="text-end">
                                                        <t t-if="doc.company_id.hide_col_line_total == False">
                                                            <span t-field="doc.amount_total"
                                                        t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: doc.currency_id}" />
                                                        </t>
                                                        <t t-if="doc.company_id.hide_col_line_total == True">
                                                            <span t-field="doc.amount_untaxed"
                                                        t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: doc.currency_id}" />
                                                        </t>
                                                    </td>
                                                </t>
                                            </tr>
                                        </tbody>
                                    </table>
                                    <!-- Totals -->
                                    <div class="text-end" style="display:none">
                                        <p style="display:none">
                                            <strong>Subtotal:</strong>
                                            <span t-field="doc.amount_untaxed"
                                    t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: doc.currency_id}" />
                                        </p>
                                        <p style="display:none">
                                            <strong>IGV 18%:</strong>
                                            <span t-field="doc.amount_tax"
                                    t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: doc.currency_id}" />
                                        </p>
                                        <p style="display:none">
                                            <strong>Total:</strong>
                                            <span t-field="doc.amount_total"
                                    t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: doc.currency_id}" />
                                        </p>
                                    </div>
                                    <!-- Notas -->
                                    <div t-if="doc.note" class="notes">
                                        <t t-esc="doc.note" />
                                    </div>
                                    <!-- Bank Information -->
                                    <p>
                                        <strong>"SIRVASE A BONAR EN NUESTRAS CUENTAS"</strong>
                                    </p>
                                    <table class="table-banks">
                                        <thead>
                                            <tr>
                                                <th>Banco</th>
                                                <th>Moneda</th>
                                                <th>Tipo</th>
                                                <th>Cuenta</th>
                                                <th>CCI</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr>
                                                <td>BCP</td>
                                                <td>Soles</td>
                                                <td>Corriente</td>
                                                <td>355-2511864-0-20</td>
                                                <td>002-355-002511864020-67</td>
                                            </tr>
                                            <tr>
                                                <td>BBVA</td>
                                                <td>Soles</td>
                                                <td>Corriente</td>
                                                <td>0011-0235-0100171749</td>
                                                <td>011-235-000100171749-93</td>
                                            </tr>
                                            <tr>
                                                <td>CAJA HUANCAYO</td>
                                                <td>Soles</td>
                                                <td>Corriente</td>
                                                <td>1070022110084408924</td>
                                                <td>808-002-211008408924-07</td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                                <div class="footer" style="font-family: Monaco;">
                                    <br />
                                    <div class="text-muted text-center"> Página:
                                        <span class="page" /> /
                                        <span
                                class="topage" />
                                    </div>
                                </div>
                            </t>
                        </t>
                    </t>
                </t>
            </xpath>
        </template>
    </data>
</odoo>