<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_view_inherit_acs" model="ir.ui.view">
        <field name="name">product.template.form.inherit.acs</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//group[@name='group_general']" position="inside">
                <field name="acs_exclude_from_manufacturing" />
            </xpath>
        </field>
    </record>
    <!-- Vista para product.product - Agregar después del campo weight -->
    <record id="product_product_form_view_inherit_bobina" model="ir.ui.view">
        <field name="name">product.product.form.inherit.bobina</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_variant_easy_edit_view" />
        <field name="arch" type="xml">
            <!-- Buscar el campo weight dentro del grupo weight y agregar después-->
            <xpath expr="//field[@name='barcode']" position="after">
                <field name="bobina_number" invisible="1" />
            </xpath>
        </field>
    </record>

    <record id="product_product_form_view_inherit_bobina_normal" model="ir.ui.view">
        <field name="name">product.product.form.inherit.bobina.normal</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='barcode']" position="after">
                <field name="bobina_number" invisible="1" />
            </xpath>
        </field>
    </record>
</odoo>