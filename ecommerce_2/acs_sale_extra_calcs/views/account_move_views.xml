<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit_acs" model="ir.ui.view">
        <field name="name">account.move.form.inherit.acs</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <!-- Campos en líneas de factura -->
            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='quantity']"
                position="before">
                <field name="acs_cant_pzs" readonly="1" optional="hide" />
                <field name="acs_udv" options="{'no_create': True, 'no_edit': True, 'no_open':True}"
                    readonly="1" optional="hide" />
                <field name="acs_largue_pza" readonly="1" optional="hide" />
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='price_unit']"
                position="after">
                <field name="acs_price_pza" readonly="1" optional="hide" />
            </xpath>
        </field>
    </record>
</odoo>