<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista de Lista (Tree) para Colores -->
    <record id="view_sale_order_line_colors_tree" model="ir.ui.view">
        <field name="name">sale.order.line.colors.tree</field>
        <field name="model">sale.order.line.colors</field>
        <field name="type">list</field>
        <field name="arch" type="xml">
            <list string="Colores" editable="bottom">
                <field name="name" />
            </list>
        </field>
    </record>

    <!-- Acción de Ventana para Colores -->
    <record id="action_sale_order_line_colors" model="ir.actions.act_window">
        <field name="name">Colores</field>
        <field name="res_model">sale.order.line.colors</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crea un nuevo color para usar en las líneas de venta.
            </p>
        </field>
    </record>

    <!-- Elemento de Menú para Colores -->
    <menuitem id="menu_sale_order_line_colors"
        name="Colores"
        parent="sale.menu_sale_config"
        action="action_sale_order_line_colors"
        sequence="30" />
</odoo>