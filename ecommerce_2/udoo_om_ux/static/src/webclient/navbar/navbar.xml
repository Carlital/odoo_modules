<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="udoo_om_ux.OmuxNavBar" t-inherit="web.NavBar" t-inherit-mode="primary">
        <xpath expr="//DropdownItem[@t-esc='currentApp.name']" position="replace"/>
        <xpath expr="//nav" position="attributes">
            <attribute name="t-ref">nav</attribute>
        </xpath>
        <xpath expr="//t[@t-call='web.NavBar.AppsMenu']" position="replace">
            <t t-if="!env.isSmall and !ue.sidenav">
                <a class="u_navbar_logo d-flex align-items-center me-1" href="/web">
                    <img src="/uilogo"/>
                </a>
            </t>
            <div t-if="!isScopedApp" class="d-flex align-items-center" t-ref="menuApps">
                <t t-call="udoo.NavBar.AppsMenu"/>
                <t t-if="env.isSmall">
                    <t t-call="web.NavBar.AppsMenu.Sidebar"/>
                </t>
            </div>
            <a t-else="" t-att-href="pwa.startUrl" class="o_menu_toggle" t-ref="menuApps">
                <img
                    t-if="currentApp &amp;&amp; currentApp.webIconData"
                    t-att-src="currentApp.webIconData"
                    class="o_menu_brand_icon d-none d-lg-inline position-absolute start-0 h-100 ps-1 ms-2"
                    t-att-alt="currentApp.name"
                    t-ref="appIcon"/>
                <span
                    t-if="currentApp"
                    t-esc="currentApp.name"
                    class="o_menu_brand d-none d-md-flex ps-4 pe-0"/>
            </a>
            <t t-if="!env.isSmall">
                <!-- App Brand -->
                <DropdownItem
                    t-if="!env.isSmall and !ue.sidenav and currentApp"
                    class="'o_menu_brand ms-2'"
                    t-esc="currentApp.name"
                    attrs="{ href: getMenuItemHref(currentApp), 'data-menu-xmlid': currentApp.xmlid, 'data-section': currentApp.id }"
                    onSelected="() => this.onNavBarDropdownItemSelection(currentApp)"
                />
                <t t-if="ue.sidenav" t-portal="'.sidenav_content'">
                    <!-- NOTE: currentApp is raw menusData, orderedApps element is processes menusData -->
                    <div t-if="currentApp and !uo.fav_menus.includes(currentApp.xmlid)" class="nav-item">
                        <t t-call="udoo.Sidenav.Item">
                            <t t-set="app" t-value="currentApp"/>
                            <t t-set="appsub" t-value="getAppSections(currentApp.id)"/>
                        </t>
                    </div>
                    <div t-foreach="uo.orderedApps" t-if="uo.fav_menus.includes(app.xmlid)" t-as="app" t-key="app.id" class="nav-item">
                        <t t-call="udoo.Sidenav.Item">
                            <t t-set="app" t-value="app"/>
                            <t t-set="appsub" t-value="getAppSections(app.id)"/>
                        </t>
                    </div>
                </t>
                <t t-if="ue.sidenav" t-portal="'.sidenav_footer'">
                    <ul class="nav d-block">
                        <li t-foreach="uo.recents" t-as="action" t-key="action_index" class="nav-item">
                            <a t-on-click.synthetic="() => this.openRecentAction(action)" class="nav-link cursor-pointer">
                                <span t-if="action.act_class" class="text-truncate" t-attf-title="{{action.act_class}}: {{action.name}}" t-out="action.name"/>
                                <span t-else="" class="text-truncate" t-att-title="action.name" t-out="action.name"/>
                            </a>
                        </li>
                    </ul>
                </t>
            </t>
        </xpath>
    </t>
    <t t-inherit="web.NavBar.AppsMenu.Sidebar" t-inherit-mode="extension">
        <xpath expr="//i" position="replace"/>
    </t>
    <t t-name="udoo.NavBar.AppsMenu">
        <div class="o-dropdown dropdown o_navbar_apps_menu">
            <span class="btn btn-light d-flex px-1" type="button" id="island_toggler" accesskey="h" title="Workspace" t-on-click.self.stop.prevent="() => { env.isSmall ? this._openAppMenuSidebar() : this.toggleWorkspace() }" t-att-aria-expanded="uState.isopen ? 'true' : 'false'">
                <i class="ri-lg ri-menu-2-line pe-none"/>
            </span>
            <div t-att-scheme="ui.color_scheme" t-ref="island" role="menu" class="island dropdown-menu p-0" t-att-class="{ 'show': uState.isopen, 'wide_island': !env.isSmall and uo.ps_full_iland }" aria-labelledby="island_toggler">
                <div t-if="!env.isSmall and uo.ps_full_iland" class="island_mask">
