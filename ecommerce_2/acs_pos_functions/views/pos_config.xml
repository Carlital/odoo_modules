<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="pos_config_view_form" model="ir.ui.view">
        <field name="name">pos.config.form.view</field>
        <field name="model">pos.config</field>
        <field name="inherit_id" ref="point_of_sale.pos_config_view_form"/>
        <field name="arch" type="xml">
           <xpath expr="//setting[@id='other_devices']" position="before">
            <setting
                    title="Disable CTRL p"
                    string="Deshabilita el Ctrl + P">
                <field name="disable_ctrl_p"/>
            </setting>
            <setting
                    title="Disable click derecho"
                    string="Deshabilita el Click derecho">
                <field name="disable_right_click"/>
            </setting>
           </xpath>
        </field>
    </record>

</odoo>
