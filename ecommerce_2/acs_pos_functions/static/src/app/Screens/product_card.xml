<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="acs_pos_functions.ProductCard" t-inherit="point_of_sale.ProductCard" t-inherit-mode="extension">
        <xpath expr="//h1[hasclass('product-cart-qty')]" position="attributes">
            <attribute name="style">display: none !important;</attribute>
        </xpath>
        <xpath expr="//div[hasclass('product-information-tag')]" position="attributes">
            <attribute name="style">display: none !important;</attribute>
        </xpath>
        
    </t>
</templates>
