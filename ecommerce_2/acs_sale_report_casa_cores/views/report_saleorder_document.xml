                                    <br/>
                                    <div style="width:100%; border: 2px solid #333;border-radius:8px;padding:5px;font-size: 13px;">
                                        <!-- Dias de validez-->
                                        <t t-set="dias_validez" t-value="0"/>
                                        <t t-set="texto_validez" t-value="'Sin Oferta'"/>
                                        <t t-if="doc.validity_date and doc.date_order">
                                            <!-- Convertimos datetime a date usando métodos string -->
                                            <t t-set="fecha_emision" t-value="doc.date_order.strftime('%Y-%m-%d')"/>
                                            <t t-set="fecha_vencimiento" t-value="doc.validity_date.strftime('%Y-%m-%d')"/>
                                            <t t-set="dias_validez_calc" t-value="(datetime.datetime.strptime(fecha_vencimiento, '%Y-%m-%d').date() - datetime.datetime.strptime(fecha_emision, '%Y-%m-%d').date()).days"/>
                                            <t t-if="dias_validez_calc > 1">
                                                <!-- <t t-set="dias_validez" t-value="dias_validez_calc"/> -->
                                                <t t-set="texto_validez" t-value="'%d DÍAS' % dias_validez_calc"/>
                                            </t>
                                            <t t-if="dias_validez_calc == 1">
                                                <t t-set="texto_validez" t-value="'%d DÍA' % dias_validez_calc"/>
                                            </t>
                                        </t>
                                        <!-- Dias de entrega-->
                                        <t t-set="dias_entrega" t-value="0"/>
                                        <t t-set="texto_entrega" t-value="'Entrega Inmediata'"/>
                                        <t t-if="doc.date_order and doc.commitment_date">
                                            <t t-set="fecha_emision" t-value="doc.date_order.strftime('%Y-%m-%d')"/>
                                            <t t-set="fecha_entrega" t-value="doc.commitment_date.strftime('%Y-%m-%d')"/>
                                            <t t-set="dias_calculados" t-value="(datetime.datetime.strptime(fecha_entrega, '%Y-%m-%d').date() - datetime.datetime.strptime(fecha_emision, '%Y-%m-%d').date()).days"/>
                                            <t t-if="dias_calculados > 1">
                                                <!-- <t t-set="dias_entrega" t-value="dias_calculados"/> -->
                                                <t t-set="texto_entrega" t-value="'%d DÍAS' % dias_calculados"/>
                                            </t>
                                            <t t-if="dias_calculados == 1">
                                                <t t-set="texto_entrega" t-value="'%d DÍA' % dias_calculados"/>
                                            </t>
                                        </t>
                                        <strong>OBSERVACIONES:</strong>
                                        <br/>
                                        TIEMPO DE ENTREGA:
                                        <t t-esc="texto_entrega"/>
                                        <br/>
                                        VALIDEZ DE OFERTA:
                                        <t t-esc="texto_validez"/>
                                        <br/>
                                        LUGAR DE ENTREGA:
                                        <t t-esc="doc.lugar_entrega or '-'"/>
                                    </div>
                                </div>
                                <div class="footer" style="font-family: Monaco;">
                                    <br/>
                                    <div class="text-muted text-center"> Página:
                                        <span class="page"/>
                                        /
                                        <span class="topage"/>
                                    </div>
                                </div>
                            </t>
                        </t>
                    </t>
                </t>
            </xpath>
        </template>
    </data>
</odoo>