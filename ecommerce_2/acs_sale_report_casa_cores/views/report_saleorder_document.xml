                                                                    <td style="font-size:13px!important;border:0px">
                                                                        <t t-esc="doc.validity_date.strftime('%d/%m/%Y') if doc.validity_date else ''"/>
                                                                    </td>
                                                                </tr>
                                                                <tr style="border:0px">
                                                                    <td style="font-size:13px!important;border:0px">
                                                                        <strong>MONEDA</strong>:
                                                                    </td>
                                                                    <td style="font-size:13px!important;border:0px">
                                                                        <t t-esc="doc.currency_id.name"/>
                                                                    </td>
                                                                </tr>
                                                                <tr style="border:0px">
                                                                    <td style="font-size:13px!important;border:0px">
                                                                        <strong>FORMA DE PAGO</strong>:
                                                                    </td>
                                                                    <td style="font-size:13px!important;border:0px">
                                                                        <t t-if="doc.payment_term_id">
                                                                            <t t-esc="doc.payment_term_id.name"/>
                                                                        </t>
                                                                    </td>
                                                                </tr>
                                                            </tbody>
                                                        </table>
                                                    </div>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                    <!-- TABLA PRODUCTOS-->
                                    <br/>
                                    <table style="border:0px" class="table table-bordered table-products table-striped">
                                        <thead style="border:0px">
                                            <tr style="border:0px">
                                                <th style="width: 20px;background: #2f5597; border: 0px;color:#fff;border-radius:0px 0 0 0px">
                                                    <strong>Item</strong>
                                                </th>
                                                <th style="width: 80px;background: #2f5597; border-color: #09224e; border: 0px;color:#fff;">
                                                    <strong>Código</strong>
                                                </th>
                                                <th style="background: #2f5597; border-color: #09224e; border: 0px;color:#fff;">
                                                    <strong>Descripción</strong>
                                                </th>
                                                <th style="width: 30px;background: #2f5597; border: 0px;color:#fff;">
                                                    <strong>Cant.</strong>
                                                </th>
                                                <th style="width: 40px;background: #2f5597; border: 0px;color:#fff;">
                                                    <strong>U.M.</strong>
                                                </th>
                                                <th style="width: 45px;background: #2f5597; border: 0px;color:#fff;">
                                                    <strong>P.U.</strong>
                                                </th>
                                                <t t-if="doc.company_id.hide_col_discount == False">
                                                    <th style="width: 50px;background: #2f5597; border: 0px;color:#fff;" t-if="doc.order_line.filtered(lambda line: line.discount &gt; 0)">
                                                        Dcto(%)
                                                    </th>
                                                </t>
                                                <th style="width: 60px;background: #2f5597; border: 0px;color:#fff;border-radius:0 0px 0px 0">
                                                    <strong>Importe</strong>
                                                </th>
                                            </tr>
                                        </thead>
                                        <tbody style="border:0px">
                                            <t t-set="item" t-value="0"/>
                                            <tr t-foreach="[l for l in doc.order_line if not l.display_type and not l.is_downpayment]" t-as="line" style="border:0px">
                                                <td class="text-center" style="border:0px">
                                                    <t t-set="item" t-value="item + 1"/>
                                                    <span t-esc="item"/>
                                                </td>
                                                <td style="border:0px" class="text-end" t-esc="line.product_id.default_code"/>
                                                <!-- <td style="border:0px" t-esc="line.name"/> -->
                                                <td style="border:0px">
                                                    <!-- Descripción principal -->
                                                    <div t-esc="line.name.split(']')[1] if ']' in line.name else line.name"/>
                                                    <!-- Descripción adicional (usando campo estándar) -->
                                                    <!-- <t t-if="line.name != line.product_id.name">
                                                        <div t-esc="line.name.replace('[%s]' % line.product_id.default_code, '') if line.product_id.default_code else line.name" style="font-size:0.8em; color:#666;"/>
                                                    </t> -->
                                                </td>
                                                <td style="border:0px" class="text-end" t-esc="line.product_uom_qty"/>
                                                <td style="border:0px" class="text-end" t-esc="line.product_uom.name"/>
                                                <td style="border:0px" class="text-end">
                                                    <t t-if="doc.company_id.hide_col_discount == False">
                                                        <span t-field="line.price_unit" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: doc.currency_id}"/>
                                                    </t>
                                                    <t t-if="doc.company_id.hide_col_discount == True">
                                                        <span t-field="line.sale_order_line_pdesc" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: doc.currency_id}"/>
                                                    </t>
                                                </td>
                                                <t t-if="doc.company_id.hide_col_discount == False">
                                                    <td style="border:0px" class="text-end" t-if="doc.order_line.filtered(lambda line: line.discount &gt; 0)" t-esc="line.discount"/>
                                                </t>
                                                <td style="border:0px" class="text-end">
                                                    <t t-if="doc.company_id.hide_col_line_total == False">
                                                        <span t-field="line.price_total" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: doc.currency_id}"/>
                                                    </t>
                                                    <t t-if="doc.company_id.hide_col_line_total == True">
                                                        <span t-field="line.price_subtotal" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: doc.currency_id}"/>
                                                    </t>
                                                </td>
                                            </tr>
                                            <!--
                                            <tr t-if="not doc.order_line.filtered(lambda line: line.discount &gt; 0)">
