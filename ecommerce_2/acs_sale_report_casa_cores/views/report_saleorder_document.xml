                                    </table>
                                    <!-- Totals -->
                                    <div class="text-end">
                                        <p style="margin-bottom: 0;">
                                            <strong>SUBTOTAL:</strong>
                                            <span style="display: inline-block; width: 115px;" t-field="doc.amount_untaxed" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: doc.currency_id}"/>
                                        </p>
                                        <p style="margin-bottom: 0;">
                                            <strong>IGV 18%:</strong>
                                            <span style="display: inline-block; width: 115px;" t-field="doc.amount_tax" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: doc.currency_id}"/>
