<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Definir el formato de papel personalizado -->
        <record id="paperformat_sale_order" model="report.paperformat">
            <field name="name">Formato Cotización o Pedido</field>
            <field name="default" eval="False" />
            <field name="format">A4</field>
            <field name="orientation">Portrait</field>
            <field name="margin_top">7</field>
            <field name="margin_bottom">12</field>
            <field name="margin_left">7</field>
            <field name="margin_right">7</field>
            <field name="header_line" eval="False" />
            <field name="header_spacing">3</field>
        </record>
        <!-- Vincular el formato de papel al informe Cotización en PDF -->
        <record id="sale.action_report_saleorder" model="ir.actions.report">
            <field name="paperformat_id" ref="acs_sale_report_casa_cores.paperformat_sale_order" />
        </record>
        <!-- Vincular el formato de papel al informe Cotización/orden -->
        <record id="sale_pdf_quote_builder.action_report_saleorder_raw" model="ir.actions.report">
            <field name="paperformat_id" ref="acs_sale_report_casa_cores.paperformat_sale_order" />
        </record>
        <!-- Plantilla del informe -->
        <template id="report_saleorder_document_inherit" inherit_id="sale.report_saleorder_document">
            <xpath expr="//t[@t-name='sale.report_saleorder_document']" position="replace">
                <t t-name="sale.report_saleorder_document">
                    <t t-call="web.html_container">
                        <t t-foreach="docs" t-as="doc">
                            <!-- Forzar el idioma a es_PE -->
                            <t t-set="doc" t-value="doc.with_context(lang='es_PE')"/>
                            <t t-call="web.basic_layout">
                                <style>
                                    *{
                                    font-family: arial !important;
                                    }
                                    table.table-client td{
                                    padding: 2px!important; font-size: 15px !important
                                    }
                                    table.table-client td &gt; strong{
                                    padding-right: 2px !important
                                    }
                                    table.table-striped tbody tr:nth-of-type(even) {
                                    background-color: rgba(0, 0, 0, .05);
                                    }
                                    table.table-banks{
                                    width:100%; border:0px!important; border-collapse: collapse;
                                    }
                                    table.table-banks thead, table.table-banks tbody{
                                    border:0px!important
                                    }
                                    table.table-banks thead tr{
                                    border:1px solid #000 !important;background:#000;height: 30px
                                    !important;
                                    }
                                    table.table-banks thead th{
                                    color:#fff;text-align:center;vertical-align: middle
                                    }
                                    table.table-banks tbody tr{
                                    border:0px !important; border-bottom:1px dashed
                                    !important;height: 30px
                                    !important
                                    }
                                    table.table-banks tbody tr td{
                                    border:0px!important;vertical-align: middle
                                    }
                                    table.table-products tbody *{
                                    font-size: 14px
                                    }
                                </style>
                                <div class="page">
                                    <!-- Encabezado personalizado -->
                                    <table style="width:100%; border:0px!important;border-collapse: collapse;">
                                        <tbody style="border:0px!important">
                                            <tr style="border:0px!important">
                                                <td style="width:25%;vertical-align: top;border:0px!important">
                                                    <t t-if="doc.company_id.logo">
                                                        <img t-att-src="image_data_uri(doc.company_id.logo)" style="height: auto; width: 250px; vertical-align: middle;"/>
                                                    </t>
                                                </td>
                                                <td style="width:45%;text-align:left;vertical-align: top;border:0px!important">
                                                    <h5 style="padding-bottom:0px;margin-bottom:0px">
                                                        <strong>
                                                            <t t-esc="doc.company_id.name"/>
                                                        </strong>
                                                    </h5>
                                                    <span style="padding-top:0px;margin-top:0px;font-size:13px;line-height: 1.3; display: inline-block;">
                                                        <t t-esc="doc.company_id.street"/>
                                                        <br/>
                                                        <span style="text-transform:uppercase">
                                                            <t t-esc="doc.company_id.partner_id.l10n_pe_district.name"/> -
                                                            <t t-esc="doc.company_id.city"/> -
                                                            <t t-esc="doc.company_id.state_id.name"/>
                                                        </span>
                                                        <br/>
                                                        Cel:
                                                        <t t-esc="doc.company_id.phone"/>
                                                        <br/>
                                                        Correo:
                                                        <t t-esc="doc.company_id.email"/>
                                                        <br/>
                                                        <t t-esc="doc.company_id.website"/>
                                                    </span>
                                                </td>
                                                <td style="width:30%;text-align:center;vertical-align: top;border:0px!important">
                                                    <div style="border: 2px solid #333;border-radius:8px">
                                                        <h4 style="display: block;margin-bottom: 0; padding: 5px 0 3px 0;">
                                                            <strong>RUC
                                                                <t t-esc="doc.company_id.vat"/>
                                                            </strong>
                                                        </h4>
                                                        <h4 style="border-top: 2px; border-bottom:2px; border-color:#333; display:inline-block; width:100%; background:#b0b0b0; border-style:solid; border-right:0; border-left:0; margin-bottom:0; padding: 5px 0 3px 0;">
                                                            <strong>
                                                                <t t-if="doc.state == 'sale'"> PEDIDO
                                                                    <br/>
                                                                </t>
                                                                <t t-if="doc.state in ('draft', 'sent')">
                                                                    COTIZACIÓN
                                                                    <br/>
                                                                </t>
                                                                <t t-if="doc.state == 'cancel'"> NOTA
                                                                    ANULADA
                                                                    <br/>
                                                                </t>
                                                            </strong>
                                                        </h4>
                                                        <h4 style="display: block;margin-bottom: 0; padding: 5px 0 3px 0;">
                                                            <strong>Nº
                                                                <t t-esc="doc.name"/>
                                                            </strong>
                                                        </h4>
                                                    </div>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                    <br/>
                                    <!-- TABLA CLIENTE -->
                                    <table class="table-client" style="width:100%; border:0px!important;border-collapse: collapse; font-size:13px!important">
                                        <tbody style="border:0px">
                                            <tr style="border:0px">
                                                <td style="width: 66%; border:0px!important;vertical-align:top">
                                                    <div style="border: 2px solid #333;border-radius:8px;padding:5px; margin-right:10px">
                                                        <table style="width:100%; border:0px!important;border-collapse: collapse;">
                                                            <tbody style="border:0px">
                                                                <tr style="border:0px">
                                                                    <td style="font-size:13px!important;border:0px" colspan="2">
                                                                        <strong>DATOS DEL CLIENTE</strong>
                                                                    </td>
                                                                </tr>
                                                                <tr style="border:0px">
                                                                    <td style="font-size:13px!important;border:0px">
                                                                        <strong>RUC/DNI</strong>:
                                                                    </td>
                                                                    <td style="font-size:13px!important;border:0px">
                                                                        <t t-esc="doc.partner_id.vat"/>
                                                                    </td>
                                                                </tr>
                                                                <tr style="border:0px">
                                                                    <td style="font-size:13px!important;border:0px;width:120px">
                                                                        <strong>RAZÓN SOCIAL</strong>:
                                                                    </td>
                                                                    <td style="font-size:13px!important;border:0px">
                                                                        <t t-esc="doc.partner_id.name"/>
                                                                    </td>
                                                                    <tr style="border:0px">
                                                                        <td style="font-size:13px!important;border:0px;height:44px">
                                                                            <strong>DIRECCIÓN</strong>:
                                                                        </td>
                                                                        <td style="font-size:13px!important;border:0px">
                                                                            <t t-esc="doc.partner_id.street"/>
                                                                            -
                                                                            <t t-esc="doc.partner_id.l10n_pe_district.name"/>
                                                                            ,
                                                                            <t t-esc="doc.partner_id.city_id.name"/>
                                                                            ,
                                                                            <t t-esc="doc.partner_id.state_id.name"/>
                                                                        </td>
                                                                    </tr>
                                                                </tr>
                                                            </tbody>
                                                        </table>
                                                    </div>
                                                </td>
                                                <td style="width: 34%; border:0px!important;vertical-align:top">
                                                    <div style="border: 2px solid #333;border-radius:8px;padding:5px;">
                                                        <table style="width:100%; border:0px!important;border-collapse: collapse;">
                                                            <tbody style="border:0px">
                                                                <tr style="border:0px">
                                                                    <td colspan="2" style="border:0px;height:20px"/>
                                                                </tr>
                                                                <tr style="border:0px">
                                                                    <td style="font-size:13px!important;border:0px">
                                                                        <strong>FECHA DE EMISIÓN</strong>:
                                                                    </td>
                                                                    <td style="font-size:13px!important;border:0px">
                                                                        <t t-esc="doc.get_local_date_str()"/>
                                                                    </td>
                                                                </tr>
                                                                <tr style="border:0px">
                                                                    <td style="font-size:13px!important;border:0px">
                                                                        <strong>FECHA DE VENCIMIENTO</strong>:
