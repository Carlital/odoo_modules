<odoo>
  <data>

    <record model="ir.ui.view" id="view_pe_eguide_tree">
      <field name="name">pe.eguide.tree</field>
      <field name="model">pe.eguide</field>
      <field name="arch" type="xml">
        <list>
            <field name="name"/>
            <field name="state"/>
            <field name="pe_date"/>
            <field name="pe_return_code"/>
        </list>
      </field>
    </record>

    <record id="view_pe_eguide_from" model="ir.ui.view">
        <field name="name">pe.eguide.form</field>
        <field name="model">pe.eguide</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_sent" string="Sent" invisible="state != 'to_send'" type="object" groups="l10n_pe_cpe.group_pe_cpe_user" />
                    <button name="action_done" string="Done" invisible="state != 'to_check'" type="object" groups="l10n_pe_cpe.group_pe_cpe_user" />
                    <button name="action_document_status" string="Document Status" 
                    invisible="state not in ('to_send','generate','to_check', 'sent')"
                    type="object" groups="l10n_pe_cpe.group_pe_cpe_user" />
                    <button name="action_cancelled" string="Cancel" invisible="state != 'to_check'" type="object" groups="l10n_pe_cpe.group_pe_cpe_user" />
                    <button name="action_to_send" string="To Send" satate="state != 'cancelled'" type="object" groups="l10n_pe_cpe.group_pe_cpe_user" />
                  <field name="state" widget="statusbar" statusbar_visible="to_send,generate,sent"/>
                </header>
                <sheet string="Electronic Guide">
                    <h1 class="mt0">
                        <field name="name" readonly="1" class="oe_inline" />
                    </h1>
                    <group>
                        <group>
                            <field name="pe_date" readonly="state != 'to_send'"/>
                            <field name="pe_ticket" readonly="state != 'to_send'"/>
                            <field name="pe_return_code" readonly="state != 'to_send'"/>
                            <field name="pe_response" readonly="state != 'to_send'"/>
                        </group>
                        <group>
                            <field name="pe_send_date" readonly="state != 'to_send'"/>
                            <field name="pe_date_end" readonly="state != 'to_send'"/>
                            <field name="picking_id" readonly="state != 'to_send'"/>
                            <field name="company_id" options="{'no_create': True}" groups="base.group_multi_company" readonly="state != 'to_send'"/>
                        </group>
                    </group>
                    <notebook colspan="4">
                        <page string="Daily Summary details">
                            <group>
                                <group>
                                    <field name="attachment_id" readonly="state != 'to_send'"/>
                                </group>
                                <group>
                                    <field name="pe_response_id" readonly="state != 'to_send'"/>
                                </group>
                            </group>
                            <div>
                              <label for="pe_note" string="Additional notes..." />
                              <field name="pe_note" readonly="state != 'to_send'"/>
                            </div>
                        </page>
                        
                    </notebook>
                </sheet>

            </form>
        </field>
    </record>

    <record id="action_pe_eguide" model="ir.actions.act_window">
        <field name="name">Electronic Guide</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">pe.eguide</field>
        <field name="view_mode">list,form</field>
        <field name="help">Display and manage the CPE.</field>
    </record>

    <menuitem name="Electronic Guides" id="pe_guide_menu" parent="l10n_pe_cpe.pe_cpe_root"
      action="action_pe_eguide" sequence="10" />

  </data>
</odoo>