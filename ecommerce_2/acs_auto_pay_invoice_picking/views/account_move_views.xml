<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_move_form_inherit_acs" model="ir.ui.view">
        <field name="name">account.move.form.inherit.acs</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <!-- Botón para imprimir el ticket -->
            <div class="oe_button_box" name="button_box" position="inside">
                <button name="action_print_invoice_ticket"
                    type="object"
                    string="CPE TKT"
                    class="oe_stat_button"
                    icon="fa-receipt"
                    invisible="state != 'posted' or move_type not in ('out_invoice', 'out_refund')" />
            </div>
        </field>
    </record>
</odoo>