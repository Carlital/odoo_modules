<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="res_users_view_form_profile_signature" model="ir.ui.view">
            <field name="name">res.users.view.form.profile.signature.inherit</field>
            <field name="model">res.users</field>
            <field name="inherit_id" ref="hr.res_users_view_form_profile" />
            <field name="arch" type="xml">
                <xpath expr="//group[@name='preferences']" position="inside">
                    <label for="signature_image" string="Subir/Cambiar Firma" />
                    <field name="signature_image" widget="image" class="oe_avatar" />
                </xpath>
            </field>
        </record>
    </data>
</odoo>