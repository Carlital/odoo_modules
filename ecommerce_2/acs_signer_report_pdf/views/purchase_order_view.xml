<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_order_form_signer" model="ir.ui.view">
        <field name="name">purchase.order.form.signer.inherit</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form" />
        <field name="arch" type="xml">
            <xpath expr="//notebook/page[@name='purchase_delivery_invoice']" position="after">
                <page string="Usuarios Firmantes" name="signer_users">
                    <group>
                        <field
                            name="signer_user_ids"
                            widget="many2many_checkboxes"
                            options="{'no_create_edit': True}"
                            domain="[('signature_image', '!=', False), ('id', '=', uid)]" />
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>