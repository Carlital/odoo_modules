<odoo>
  <data>
    <record id="product_template_search_view_inherit" model="ir.ui.view">
      <field name="name">product.template.search</field>
      <field name="model">product.template</field>
      <field name="inherit_id" ref="product.product_template_search_view"/>
      <field name="arch" type="xml">
        <xpath expr="//field[@name='name']" position="before">
          <field name="advanced_search" string="Advanced Search" filter_domain="[('advanced_search','=',self)]"/>
          <field name="standard_name" string="Codigo Interno" filter_domain="[('standard_name','=',self)]"/>
        </xpath>
      </field>
    </record>
    <record id="product_template_tree_view_inherit" model="ir.ui.view">
      <field name="name">product.template.tree.inherit</field>
      <field name="model">product.template</field>
      <field name="inherit_id" ref="product.product_template_tree_view"/>
      <field name="arch" type="xml">
        <xpath expr="//field[@name='default_code']" position="before">
          <field name="standard_name" string="Código Interno"/>
        </xpath>
      </field>
    </record>

    <record id="product_template_form_standard_name_add" model="ir.ui.view">
        <field name="name">product.template.product.form.standard.name</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view" />
        <field name="arch" type="xml">
            <field name="type" position="after">
                <field name="standard_name" />
            </field>
        </field>
    </record>
    
