<odoo>
  <data>
    <!-- explicit list view definition -->
    <record model="ir.ui.view" id="view_pe_electronic_guide_session_list">
      <field name="name">pe.electronic.guide.session.session.list</field>
      <field name="model">pe.electronic.guide.session</field>
      <field name="arch" type="xml">
        <list string="Electronic Guide">
          <field name="name"/>
          <field name="branch_id" />
          <field name="company_id" />
        </list>
      </field>
    </record>

    <record id="view_pe_electronic_guide_session_form" model="ir.ui.view">
      <field name="name">pe.electronic.guide.session.form</field>
      <field name="model">pe.electronic.guide.session</field>
      <field name="arch" type="xml">
          <form>
            <header>
            </header>
            <sheet string="Electronic Guide">
              <div class="oe_button_box" name="button_box">
                  <button name="toggle_active" type="object" class="oe_stat_button" icon="fa-archive">
                      <field name="active" widget="boolean_button" options='{"terminology": "archive"}'/>
                  </button>
              </div>
              <h1 class="mt0">
                  <field name="name" placeholder='Example "T001"' class="oe_inline" />
              </h1>

              <group>
                <group string="Users">
                  <field name="user_ids" nolabel="1" colspan="4"/>
                </group>
                <group>
                  <field name="branch_id"  widget="selection"/>
                  <field name="sequence_id" />
                  <field name="company_id" />
                </group>
              </group>

            </sheet>
            <!-- Attachment preview -->
            <div class="o_attachment_preview" />
            <!-- Chatter -->
            <chatter reload_on_attachment="True"/>
          </form>
      </field>
    </record>

    <!-- actions opening views on models -->
    <record model="ir.actions.act_window" id="action_pe_electronic_guide_session">
      <field name="name">Session</field>
      <field name="res_model">pe.electronic.guide.session</field>
      <field name="view_mode">list,form</field>
      <field name="view_id" ref="view_pe_electronic_guide_session_list"/>
      <!--field name="context">{'search_default_dashboard':1}</field -->
      <field name="help" type="html">
          <p>
              This is the Electronic Guide Session.
          </p>
      </field>
    </record>

  </data>
</odoo>