<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <template id="report_pe_eguide_advanced">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <t t-set="lang" t-value="o.partner_id.lang"/>
                    <t t-if="o._get_name_electronic_guide_report()=='l10n_pe_eguide_advanced.report_pe_eguide_advanced_document_custom'"
                       t-call="l10n_pe_eguide_advanced.report_pe_eguide_advanced_document_custom" t-lang="lang"/>
                    <t t-if="o._get_name_electronic_guide_report()=='l10n_pe_eguide_advanced.report_pe_eguide_advanced_document_stylized'"
                       t-call="l10n_pe_eguide_advanced.report_pe_eguide_advanced_document_stylized" t-lang="lang"/>
                    <t t-if="o._get_name_electronic_guide_report()=='l10n_pe_eguide_advanced.report_pe_eguide_advanced_document_standard'"
                       t-call="l10n_pe_eguide_advanced.report_pe_eguide_advanced_document_standard" t-lang="lang"/>
                </t>
            </t>
        </template>

        <record id="action_report_cpe" model="ir.actions.report">
            <field name="name">Electronic Guide</field>
            <field name="model">pe.electronic.guide</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">l10n_pe_eguide_advanced.report_pe_eguide_advanced</field>
            <field name="report_file">l10n_pe_eguide_advanced.report_pe_eguide_advanced</field>
            <field name="print_report_name">('%s' % (object.name).replace("/",'_'))</field>
            <field name="binding_model_id" ref="model_pe_electronic_guide"/>
            <field name="binding_type">report</field>
        </record>

    </data>
</odoo>