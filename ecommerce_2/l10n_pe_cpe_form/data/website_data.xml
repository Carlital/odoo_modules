<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>


        <template id="l10n_pe_cpe_form.querycpe" name="CPE Search">
            <t t-call="website.layout">
                <div id="wrap" class="oe_structure oe_empty">
                    <section class="s_title parallax s_parallax_is_fixed bg-black-50 pt24 pb24" data-vcss="001" data-snippet="s_title" data-scroll-background-ratio="1">
                        <span class="s_parallax_bg oe_img_bg" style="background-image: url('/web/image/website.s_parallax_default_image'); background-position: 50% 0;"/>
                        <div class="o_we_bg_filter bg-black-50"/>
                        <div class="container">
                            <h1>Search CPE</h1>
                        </div>
                    </section>
                    <section class="s_text_block pt40 pb40 o_colored_level " data-snippet="s_text_block">
                        <div class="container s_allow_columns">
                            <div class="row">
                                <div class="col-lg-12">
                                    <p class="lead">
                                        Use the form below to search for your CPE documents. Please provide the required information, and we will assist you in finding the document you need.
                                    </p>
                                    <section class="s_website_form" data-vcss="001" data-snippet="s_website_form">
                                        <div class="container">
                                            <form id="cpe_form" action="/website/form/" method="post" enctype="multipart/form-data" class="o_mark_required" data-mark="*" data-model_name="pe.query.cpe.form" data-success-mode="redirect" data-success-page="/cpe-not-found" data-pre-fill="true">
                                                <div class="s_website_form_rows row s_col_no_bgcolor">
                                                    <div class="mb-3 col-lg-6 s_website_form_field s_website_form_custom s_website_form_required" data-type="char" data-name="Field">
                                                        <label class="s_website_form_label" style="width: 200px" for="vat">
                                                            <span class="s_website_form_label_content">N° Client Document</span>

                                                        </label>
                                                        <input id="vat" type="text" class="form-control s_website_form_input" name="vat" data-fill-with="vat"/>
                                                    </div>

                                                    <div class="mb-3 col-lg-6 s_website_form_field s_website_form_custom s_website_form_required" data-type="char" data-name="Field">
                                                        <label class="s_website_form_label" style="width: 200px" for="vat">
                                                            <span class="s_website_form_label_content">Document Type</span>

                                                        </label>

                                                        <!--input id="vat" type="text" class="form-control s_website_form_input" name="vat" data-fill-with="vat"/-->
                                                        <select class="form-select s_website_form_input" name="document_type_code" id="document_type_code">
                                                            <option value="" selected="selected">Select Document Type</option>
                                                            <option value="01">Factura</option>
                                                            <option value="03">Boleta</option>
                                                            <option value="07">Nota de Crédito</option>
                                                            <option value="08">Nota de Débito</option>
                                                        </select>
                                                    </div>

                                                    <div class="mb-3 col-lg-6 s_website_form_field s_website_form_custom" data-type="char" data-name="Field">
                                                        <label class="s_website_form_label" style="width: 200px" for="number">
                                                            <span class="s_website_form_label_content">Number</span>
                                                            <span class="s_website_form_mark"> *</span>
                                                        </label>
                                                        <input id="number" type="text" pattern="^(B|F){1}[A-Z0-9]{3}-\d{1,8}$" class="form-control s_website_form_input" name="number" required="" data-fill-with="number"/>
                                                    </div>
                                                    <div class="mb-3 col-lg-6 s_website_form_field s_website_form_required s_website_form_model_required" data-type="date" data-name="Field">
                                                        <label class="s_website_form_label" style="width: 200px" for="invoice_date">
                                                            <span class="s_website_form_label_content">Date Invoice</span>
                                                            <span class="s_website_form_mark"> *</span>
                                                        </label>
                                                        <div class="s_website_form_date input-group date" id="invoice_date">
                                                            <input
                                                                    type="text"
                                                                    class="form-control datetimepicker-input s_website_form_input"
                                                                    name="invoice_date"
                                                                    required=""
                                                                    data-fill-with="invoice_date"
                                                            />
                                                            <div class="input-group-text o_input_group_date_icon"><i class="fa fa-calendar"></i></div>
                                                        </div>
                                                        <!--input id="invoice_date" type="text" class="form-control s_website_form_input" name="invoice_date" required="" data-fill-with="invoice_date"/-->
                                                    </div>
                                                    <div class="mb-3 col-lg-6 s_website_form_field s_website_form_custom" data-type="char" data-name="Field">
                                                        <label class="s_website_form_label" style="width: 200px" for="number">
                                                            <span class="s_website_form_label_content">Amount</span>
                                                            <span class="s_website_form_mark"> *</span>
                                                        </label>
                                                        <input id="number" type="text" inputmode="numeric" pattern="^\d+(\.\d{1,2})?$" class="form-control s_website_form_input" name="amount" required="" data-fill-with="number"/>
                                                    </div>
                                                    <div class="mb-0 py-2 col-12 s_website_form_submit s_website_form_no_submit_label text-end" data-name="Submit Button">
                                                        <div style="width: 200px;" class="s_website_form_label"/>
                                                        <a href="#" role="button" class="btn btn-primary s_website_form_send s_website_cpe_form_send">Submit</a>
                                                        <span id="s_website_form_result"></span>
                                                    </div>
                                                </div>
                                            </form>
                                        </div>
                                    </section>
                                </div>
                                <!--div class="col-lg-4 offset-lg-1 mt-4 mt-lg-0">
                                    <h5>My Company</h5>
                                    <ul class="list-unstyled mb-0 ps-2">
                                        <li><i class="fa fa-map-marker fa-fw me-2"/><span class="o_force_ltr">3575 Fake Buena Vista Avenue</span></li>
                                        <li><i class="fa fa-phone fa-fw me-2"/><span class="o_force_ltr">+1 555-555-5556</span></li>
                                        <li><i class="fa fa-1x fa-fw fa-envelope me-2"/><span>info@yourcompany.example.com</span></li>
                                    </ul>
                                </div-->
                            </div>
                        </div>
                    </section>
                </div>
            </t>
        </template>

        <record id="querycpe_page" model="website.page">
            <field name="url">/cpe</field>
            <field name="is_published">True</field>
            <field name="view_id" ref="querycpe"/>
            <field name="track">True</field>
            <field name="website_meta_description">This is the cpe search of the website</field>
        </record>

        <record id="l10n_pe_cpe_form.querycpe_not_found" model="website.page">
            <field name="name">CPE Not Found</field>
            <field name="type">qweb</field>
            <field name="url">/cpe-not-found</field>
            <field name="website_indexed" eval="False"/>
            <field name="is_published">True</field>
            <field name="key">l10n_pe_cpe_form.querycpe_not_found</field>
            <field name="arch" type="xml">
                <t name="CPE Not Found" t-name="l10n_pe_cpe_form.querycpe_not_found">
                    <t t-call="website.layout">
                        <div id="wrap" class="oe_structure oe_empty">
                            <section class="s_text_block pt40 pb40 o_colored_level " data-snippet="s_text_block">
                                <div class="container s_allow_columns">
                                    <div class="row">
                                        <div class="col-lg-12 text-center">
                                            <div class="d-inline-block mx-auto p-4">
                                                <i class="fa fa-exclamation-circle fa-2x mb-3 rounded-circle text-bg-danger" role="presentation"/>
                                                <div class="alert alert-primary" role="alert">
                                                  <h1 class="fw-bolder">CPE Not Found</h1>
                                                </div>
                                                <a href="/cpe" role="button" class="btn btn-primary s_website_form_send s_website_cpe_form_send">Try Again</a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </section>
                        </div>
                    </t>
                </t>
            </field>
        </record>`
    </data>
</odoo>