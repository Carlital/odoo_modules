<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <record model="ir.module.category" id="module_category_pe_account">
            <field name="name">Electronic Books</field>
            <field name="description">Set up electronic books</field>
            <field name="sequence">50</field>
        </record>

        <record id="group_pe_account" model="res.groups">
            <field name="name">User</field>
            <field name="category_id" ref="module_category_pe_account"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_pe_account_account" model="res.groups">
            <field name="name">Accountant</field>
            <field name="category_id" ref="module_category_pe_account"/>
            <field name="implied_ids" eval="[(4, ref('group_pe_account'))]"/>
        </record>

        <record id="group_pe_account_manager" model="res.groups">
            <field name="name">Administrator</field>
            <field name="category_id" ref="module_category_pe_account"/>
            <field name="implied_ids" eval="[(4, ref('group_pe_account_account'))]"/>
        </record>

        <record id="base.user_admin" model="res.users">
            <field name="groups_id" eval="[(4, ref('l10n_pe_account.group_pe_account'))]"/>
        </record>

        <record id="base.group_system" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('l10n_pe_account.group_pe_account_manager'))]"/>
        </record>

    </data>

</odoo>
