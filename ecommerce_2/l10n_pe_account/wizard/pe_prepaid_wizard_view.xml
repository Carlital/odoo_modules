<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_pe_prepaid_wizard" model="ir.ui.view">
            <field name="name">pe.prepaid.wizard.form</field>
            <field name="model">pe.prepaid.wizard</field>
            <field name="arch" type="xml">
                <form string="Correct">
                    <group>
                         <group>
                             <field name="partner_id" readonly="True"/>
                         </group>
                         <group>
                             <field name="move_id"/>
                         </group>
                    </group>
                    <footer>
                        <button string='Apply' name="apply_prepaid" type="object" class="btn-primary" />
                        <button string="Cancel" class="btn-default" special="cancel"/>
                    </footer>
               </form>
            </field>
        </record>

        <record id="action_pe_prepaid_wizard" model="ir.actions.act_window">
            <field name="name">Correct</field>
            <field name="res_model">pe.prepaid.wizard</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="view_pe_prepaid_wizard"/>
            <field name="target">new</field>
            <!--field name="binding_model_id" ref="account.model_account_move" />
            <field name="binding_view_types">list</field-->
        </record>

    </data>
</odoo>
