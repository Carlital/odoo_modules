<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="ir.ui.view" id="view_account_journal_form">
        <field name="name">account.journal.form.inherit.l10n.pe.invoice</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_form"/>
        <field name="arch" type="xml">

            <xpath expr="//notebook//page[@name='advanced_settings']//group" position="inside">
                  <group name="peruvian_settings" string="Peruvian Settings">
                      <field name="pe_invoice_code" invisible="type not in ['sale', 'purchase']" />
                      <field name="pe_credit_note_id" invisible="type not in ['sale', 'purchase']" />
                      <field name="pe_debit_note_id" invisible="type not in ['sale', 'purchase']" />
                  </group>
            </xpath>
        </field>
    </record>
    <record id="view_tax_form" model="ir.ui.view">
        <field name="name">account.tax.form</field>
        <field name="model">account.tax</field>
        <field name="inherit_id" ref="account.view_tax_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='type_tax_use']" position="before">
                <field name="pe_tax_type" widget="selection" />
                <field name="pe_tier_range" invisible="l10n_pe_edi_tax_code != '2000'" />
            </xpath>
        </field>
    </record>
</odoo>
