<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="report_cpe_document">
            <t t-if="not o" t-set="o" t-value="doc"/>

            <t t-if="not company">
                <!-- Multicompany -->
                <t t-if="company_id">
                    <t t-set="company" t-value="company_id"/>
                </t>
                <t t-elif="o and 'company_id' in o and o.company_id.sudo()">
                    <t t-set="company" t-value="o.company_id.sudo()"/>
                </t>
                <t t-else="else">
                    <t t-set="company" t-value="res_company"/>
                </t>
            </t>
            <t t-set="o" t-value="o.with_context(lang=lang)" />
            <div class="header">
              <table class="table" style="border-top: none;">
                <tr style="border-top: none;">
                  <td scope="row"  style="border-top: none;">
                      <img t-if="company.logo" t-att-src="image_data_uri(company.logo)" style="max-height: 45px;" alt="Logo"/>
                  </td>
                  <th style="font-size: 12px;">
                    <span t-field="company.name"/><br />
                    <span t-field="company.street" style="font-weight: normal;"/><br />
                    <span t-field="company.city" style="font-weight: normal;"/>-
                      <span t-field="company.partner_id.city_id.name" style="font-weight: normal;"/>-
                      <span t-field="company.state_id.name" style="font-weight: normal;"/><br />
                  </th>
                  <td rowspan="2"  style="border-top: none; max-width: 256px; width: 256px;">
                    <div class="text-center" style="background-color: #eeeeee !important; border-radius: 10px; padding: 10px 15px 10px 15px;">
                      <h1 style="font-size: 18px !important;">
                        RUC <span t-field="company.vat"/> <br />
                        <span t-if="o.move_type in ['out_refund','out_invoice'] and o.state in ['draft','cancel','posted'] and o.pe_invoice_code">
                            <t t-esc="o.get_pe_invoice_name()" />
                            <t t-if="o.state == 'draft'">
                                Draft
                            </t>
                            <t t-if="o.state == 'cancel'">
                                Cancelled
                            </t>
                            <t t-if="o.pe_annul">
                                Annulled
                            </t>
                            <t t-if="o.pe_is_cpe and o.move_type == 'out_invoice' and o.name and o.name != '/'">
                                Electronics
                            </t>
                        </span>
                        <span t-if="o.move_type == 'out_invoice' and o.state == 'posted' and not o.pe_invoice_code">Invoice</span>
                        <span t-if="o.move_type == 'out_invoice' and o.state == 'draft' and not o.pe_invoice_code">Draft Invoice</span>
                        <span t-if="o.move_type == 'out_invoice' and o.state == 'cancel' and not o.pe_invoice_code">Cancelled Invoice</span>
                        <span t-if="o.move_type == 'out_refund' and not o.pe_invoice_code">Credit Note</span>
                        <span t-if="o.move_type == 'in_refund' and not o.pe_invoice_code">Vendor Credit Note</span>
                        <span t-if="o.move_type == 'in_invoice' and not o.pe_invoice_code">Vendor Bill</span>
                        <span t-if="o.name != '/'" t-field="o.name"/><br />
                      </h1>
                    </div>
                  </td>
                </tr>
              </table>
            </div>
            <div class="article"  t-att-data-oe-model="o and o._name" t-att-data-oe-id="o and o.id" t-att-data-oe-lang="o and o.env.context.get('lang')" style="font-size: 12px !important;">
                <div class="page">

                    <div class="row" style="border-radius: 0.25rem !important; border: 1px solid #dee2e6 !important;" >
                        <div class="col-8"  style="border-radius: 0.25rem !important; border: 1px solid #dee2e6 !important; padding: 0px 15px 0px 15px;">

                            <table style="width: 100%;">
                                <tr>
                                    <td style="width: 100%;" colspan="2">
                                        <span>Client Data</span>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="width: 20%;">
                                        <span>RUC</span>
                                    </td>
                                    <td class="text-right">
                                        <span t-field="o.partner_id.vat"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td>
                                        <span>Denomination</span>
                                    </td>
                                    <td class="text-right">
                                        <span t-field="o.partner_id.name"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td>
                                        <span>Street</span>
                                    </td>
                                    <td class="text-right">
                                        <span t-field="o.partner_id.street" /><br />
                                        <span t-if="o.partner_id.city" t-field="o.partner_id.city"/>-
                                        <span t-if="o.partner_id.city_id" t-field="o.partner_id.city_id.name"/>-
                                        <span t-if="o.partner_id.state_id" t-field="o.partner_id.state_id.name" />
                                    </td>
                                </tr>
                            </table>
                        </div>
                        <div class="col-4"  style="border-radius: 0.25rem !important; border: 1px solid #dee2e6 !important; padding: 0px 15px 0px 15px;">
                            <table style="width: 100%;">
                                <tr>
                                    <td style="width: 40%;">
                                        <span>Date</span>
                                    </td>
                                    <td class="text-right">
                                        <span t-field="o.invoice_date"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="width: 40%;">
                                        <span>Due Date:</span>
                                    </td>
                                    <td class="text-right">
                                        <span t-field="o.invoice_date_due"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="width: 40%;">
                                        <span>Currency:</span>
                                    </td>
                                    <td class="text-right">
                                        <span t-field="o.currency_id.name"/>
                                    </td>
                                </tr>
                            </table>
                        </div>


                    </div>

                    <br />
                    <table class="table table-sm o_main_table table-borderless" name="invoice_line_table">
                        <thead>
                            <tr>
                                <th name="th_description" class="text-start"><span>Description</span></th>
                                <th name="th_quantity" class="text-end"><span>Quantity</span></th>
                                <th name="th_priceunit" t-attf-class="text-end {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}"><span>Unit Price</span></th>
                                <th name="th_price_unit" t-if="display_discount" t-attf-class="text-end {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
                                    <span>Disc.%</span>
                                </th>
                                <th name="th_taxes" t-attf-class="text-start {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}"><span>Taxes</span></th>
                                <th name="th_subtotal" class="text-end">
                                    <span groups="account.group_show_line_subtotals_tax_excluded">Amount</span>
                                    <span groups="account.group_show_line_subtotals_tax_included">Total Price</span>
                                </th>
                            </tr>
                        </thead>
                        <tbody class="invoice_tbody">
                            <t t-set="current_subtotal" t-value="0"/>
                            <t t-set="lines" t-value="o.invoice_line_ids.sorted(key=lambda l: (-l.sequence, l.date, l.move_name, -l.id), reverse=True)"/>

                            <t t-foreach="lines" t-as="line">
                                <t t-set="current_subtotal" t-value="current_subtotal + line.price_subtotal" groups="account.group_show_line_subtotals_tax_excluded"/>
                                <t t-set="current_subtotal" t-value="current_subtotal + line.price_total" groups="account.group_show_line_subtotals_tax_included"/>

                                <tr t-att-class="'bg-200 fw-bold o_line_section' if line.display_type == 'line_section' else 'fst-italic o_line_note' if line.display_type == 'line_note' else ''">
                                    <t t-if="line.display_type == 'product'" name="account_invoice_line_accountable">
                                        <td name="account_invoice_line_name">
                                            <span t-field="line.name" t-options="{'widget': 'text'}"/>
                                            <t t-if="line.pe_license_plate or o.pe_license_plate">
                                                <br />Placa <span t-esc="line.pe_license_plate or o.pe_license_plate or ''"/>
                                            </t>
                                        </td>
                                        <td class="text-end">
                                            <span t-field="line.quantity"/>
                                            <span t-field="line.product_uom_id"  groups="uom.group_uom"/>
                                        </td>
                                        <td t-attf-class="text-end {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
                                            <span class="text-nowrap" t-field="line.price_unit"/>
                                        </td>
                                        <td t-if="display_discount" t-attf-class="text-end {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
                                            <span class="text-nowrap" t-field="line.discount"/>
                                        </td>
                                        <td t-attf-class="text-start {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
                                            <span t-esc="', '.join(map(lambda x: (x.description or x.name), line.tax_ids))" id="line_tax_ids"/>
                                        </td>
                                        <td class="text-end o_price_total">
                                            <span class="text-nowrap" t-field="line.price_subtotal" groups="account.group_show_line_subtotals_tax_excluded"/>
                                            <span class="text-nowrap" t-field="line.price_total" groups="account.group_show_line_subtotals_tax_included"/>
                                        </td>
                                    </t>
                                    <t t-if="line.display_type == 'line_section'">
                                        <td colspan="99">
                                            <span t-field="line.name" t-options="{'widget': 'text'}"/>
                                        </td>
                                        <t t-set="current_section" t-value="line"/>
                                        <t t-set="current_subtotal" t-value="0"/>
                                    </t>
                                    <t t-if="line.display_type == 'line_note'">
                                        <td colspan="99">
                                            <span t-field="line.name" t-options="{'widget': 'text'}"/>
                                        </td>
                                    </t>
                                </tr>

                                <t t-if="current_section and (line_last or lines[line_index+1].display_type == 'line_section')">
                                    <tr class="is-subtotal text-end">
                                        <td colspan="99">
                                            <strong class="mr16">Subtotal</strong>
                                            <span
                                                t-esc="current_subtotal"
                                                t-options='{"widget": "monetary", "display_currency": o.currency_id}'
                                            />
                                        </td>
                                    </tr>
                                </t>
                            </t>
                        </tbody>
                    </table>

                    <div class="clearfix mb-4">
                        <div id="total" class="row">
                            <div t-attf-class="#{'col-6' if report_type != 'html' else 'col-sm-7 col-md-6'} ms-auto">
                                <table class="table table-sm table-borderless" style="page-break-inside: avoid;">

                                    <!--Tax totals-->
                                    <t t-set="tax_totals" t-value="o.get_pe_amount_vals()"/>
                                    <t t-call="account.document_tax_totals"/>

                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                    <table t-if="o.pe_is_cpe" >
                        <tr>
                            <td  style="width: 35%; padding: 0px 6px 0px 2px;">
                                <strong>Method of payment:</strong>
                                <t t-if="o.pe_payment_lines and o.invoice_date != o.invoice_date_due">
                                    <span>Credit</span><br />
                                    <strong>Number of Quotas:</strong>
                                    <span t-esc="'%02d'%len(o.pe_payment_lines)"/>
                                </t>
                                <t t-else="">
                                    <span>Cash</span>
                                </t>
                                <br />
                                <t t-if="o.pe_payment_lines and o.invoice_date != o.invoice_date_due">
                                    <table class="table table-sm o_main_table">
                                        <tr>
                                            <td>
                                                <strong>Date</strong>
                                            </td>
                                            <td class="text-right">
                                                <strong>Amount</strong>
                                            </td>

                                        </tr>
                                        <tr t-foreach="o.pe_payment_lines" t-as="payment">
                                            <td>
                                                <span t-field="payment.date"/>
                                            </td>
                                            <td class="text-right"	>
                                                <span t-field="payment.amount" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td>
                                                <strong>Total</strong>
                                            </td>
                                            <td class="text-right">
                                                <strong t-esc="sum(o.pe_payment_lines.mapped('amount'))" t-options='{"widget": "monetary", "display_currency": o.currency_id}' />
                                            </td>

                                        </tr>

                                    </table>
                                </t>

                            </td>
                            <td style="width: 55%;">
                                <span t-if="o.pe_legend_ids.filtered(lambda legnd: legnd.code =='1000')">
                                    <strong>Amount in letters: </strong> <br />
                                    <span t-esc="o.pe_legend_ids.filtered(lambda legnd: legnd.code =='1000').name"/><br />
                                </span>
                                <span t-if="o.pe_is_cpe and o.edi_document_ids" ><strong>Summary: </strong> <br />
                                    <span t-field="o.pe_digest"/><br />
                                </span>
                                <t t-foreach="o.pe_legend_ids.filtered(lambda legnd: legnd.code != '1000')" t-as="p">
                                  <span t-field="p.name"/><br />
                                </t>

                            </td>

                            <td t-if="o.edi_document_ids">
                                <img t-if="o.pe_qr_code" t-att-src="'data:image/png;base64,%s' %o.pe_qr_code.decode('utf-8')"
                                    style="width: 40mm;  height: 40mm;" />
                            </td>
                        </tr>
                    </table>


            </div>

            <div t-attf-class="footer o_standard_footer">
                <div class="text-center" style="border-top: 1px solid black;">
                    <ul class="list-inline mb4">
                        <li t-if="company.phone" class="list-inline-item d-inline">Phone: <span class="o_force_ltr" t-field="company.phone"/></li>
                        <li t-if="company.email" class="list-inline-item d-inline">Email: <span t-field="company.email"/></li>
                        <li t-if="company.website" class="list-inline-item d-inline">Web: <span t-field="company.website"/></li>
                    </ul>

                    <div t-if="report_type == 'pdf'" class="text-muted">
                        Page: <span class="page"/> / <span class="topage"/>
                    </div>
                </div>
            </div>
        </template>

        <template id="report_cpe">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <t t-set="lang" t-value="o.partner_id.lang"/>
                    <t t-call="l10n_pe_cpe.report_cpe_document" t-lang="lang"/>
                </t>
            </t>
        </template>

        <record id="action_report_cpe" model="ir.actions.report">
            <field name="name">Report CPE</field>
            <field name="model">account.move</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">l10n_pe_cpe.report_cpe</field>
            <field name="report_file">l10n_pe_cpe.report_cpe</field>
            <field name="print_report_name">('%s' % (object.name))</field>
            <field name="binding_model_id" ref="model_account_move"/>
            <field name="binding_type">report</field>
        </record>

    </data>
</odoo>
