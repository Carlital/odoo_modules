<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>
        <record id="view_pe_certificate_list" model="ir.ui.view">
            <field name="name">pe.certificate.list</field>
            <field name="model">pe.certificate</field>
            <field name="arch" type="xml">
                <list string="Certificate">
                    <field name="name" />
                    <field name="start_date" />
                    <field name="end_date" />
                    <field name="state" />
                </list>
            </field>
        </record>

        <record id="view_pe_certificate_form" model="ir.ui.view">
            <field name="name">pe.certificate.form</field>
            <field name="model">pe.certificate</field>
            <field name="arch" type="xml">
                <form string="Certificate">
                    <header>
                        <button name="action_done" string="Done" invisible="state != 'draft'" type="object" groups="l10n_pe_cpe.group_pe_cpe_manager" />
                        <button name="action_draft" string="Draft" invisible="state != 'cancel'" type="object" groups="l10n_pe_cpe.group_pe_cpe_manager" />
                        <button name="action_cancelled" string="Cancelled" invisible="state != 'done'" type="object" groups="l10n_pe_cpe.group_pe_cpe_manager" />
                        <field name="state" widget="statusbar" statusbar_visible="draft,done,cancel"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1 class="mt0">
                                <field name="name" />
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="start_date" />
                            </group>
                            <group>
                                <field name="end_date" />
                            </group>
                        </group>
                        <label for="private_key" />
                        <field name="private_key" />
                        <label for="public_key" />
                        <field name="public_key" />
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_pe_certificate" model="ir.actions.act_window">
            <field name="name">Certificate</field>
            <field name="res_model">pe.certificate</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="view_pe_certificate_list"/>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                    Create a new Certificate
                </p>
            </field>
        </record>

        <menuitem id="menu_pe_certificate_root" name="Certificate" action="action_pe_certificate" parent="pe_cpe_root" sequence="1"/>
    </data>
</odoo>