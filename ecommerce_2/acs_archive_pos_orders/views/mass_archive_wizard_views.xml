<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Formulario del Wizard -->
    <record id="view_acs_mass_archive_wizard_form" model="ir.ui.view">
        <field name="name">acs.mass.archive.wizard.form</field>
        <field name="model">acs.mass.archive.wizard</field>
        <field name="arch" type="xml">
            <form string="Archivar Órdenes de POS">
                <group>
                    <p>Presione el botón para archivar todas las órdenes de POS.</p>
                </group>
                <footer>
                    <button name="action_archive_pos_orders" type="object" string="Archivar"
                        class="btn-primary" />
                    <button special="cancel" string="Cancelar" class="btn-secondary" />
                </footer>
            </form>
        </field>
    </record>

    <!-- Acción para abrir el Wizard -->
    <record id="action_acs_mass_archive_pos_orders" model="ir.actions.act_window">
        <field name="name">Archive notes invoices</field>
        <field name="res_model">acs.mass.archive.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="view_id" ref="view_acs_mass_archive_wizard_form" />
    </record>

    <!-- Menú para acceder al Wizard -->
    <menuitem
        id="menu_acs_mass_archive_pos_orders"
        name="Archive notes invoices"
        parent="base.menu_custom"
        action="action_acs_mass_archive_pos_orders"
        sequence="10"
        groups="base.group_system" /> <!-- Vinculado al grupo de administradores -->
</odoo>