<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="l10n_uy_edi_pos.OrderReceipt" t-inherit="point_of_sale.PaymentScreenButtons" t-inherit-mode="extension">
        <xpath expr="//button[hasclass('js_invoice')]/.." position="inside">
            <t t-esc="console.log(pe_journal_ids)" />
            <t t-foreach="pe_journal_ids" t-as="pe_journal_id" t-key="pe_journal_id.id">
                <button class="button js_invoice btn btn-light btn-lg d-flex justify-content-between align-items-baseline w-100 w-md-50 lh-lg" t-att-class="{ 'highlight active': currentOrder.get_pe_journal_id()==pe_journal_id.id }"
                    t-on-click="() => this.toggleSetPeJoasyncurnal(pe_journal_id.id)">
                    <span><i class="fa fa-file-text-o me-2" /><t t-esc="pe_journal_id.name" /></span>
                    <i class="fa me-2" t-attf-class="{{ currentOrder.get_pe_journal_id()==pe_journal_id.id ? 'fa-check-square text-action' : 'fa-square-o' }}" />
                </button>
            </t>
        </xpath>
        <xpath expr="//button[hasclass('js_invoice')]" position="attributes">
            <attribute name="style">display: none !important;</attribute>
        </xpath>
    </t>
</templates>
