<odoo>
    <record id="an_view_product_pricelist_item_list" model="ir.ui.view">
        <field name="name">an.product.pricelist.item.list</field>
        <field name="model">product.pricelist.item</field>
        <field name="arch" type="xml">
            <list string="Pricelist Items" delete="1">
                <field name="pricelist_id"/>
                <field name="product_tmpl_id"/>
                <field name="product_id"/>
                <field name="categ_id"/>
                <field name="min_quantity"/>
                <field name="fixed_price"/>
                <field name="price_discount"/>
                <field name="price_surcharge"/>
                <field name="price_round"/>
                <field name="price_min_margin"/>
                <field name="price_max_margin"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="currency_id" invisible="1"/>
                <field name="date_start"/>
                <field name="date_end"/>
            </list>
        </field>
    </record>

    <record id="an_product_pricelist_item_action" model="ir.actions.act_window">
        <field name="name">Pricelist Items</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">product.pricelist.item</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="an_view_product_pricelist_item_list"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new pricelist item
            </p>
            <p>
                Pricelist items allow you to set different prices for products based on conditions.
                This view makes it easy to find and delete unwanted pricelist items.
            </p>
        </field>
    </record>
</odoo>
