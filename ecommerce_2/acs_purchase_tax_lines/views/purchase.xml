<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="acs_purchase_tax_lines_form" model="ir.ui.view">
        <field name="name">acs.purchase.tax.lines.form</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <div name="date_planned_div" position="after">
                <field name="general_taxes" invisible="0"/>
                <field name="tax_ids" widget="many2many_tags"  options="{'no_open': True, 'no_create': True}" invisible="general_taxes == False" required="general_taxes == True"/>
            </div>
        </field>
    </record>
</odoo>