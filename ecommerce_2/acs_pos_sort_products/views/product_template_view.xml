<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_view_pos_sort" model="ir.ui.view">
        <field name="name">product.template.form.pos.sort</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='type']" position="after">
                <field name="acs_sort_pos_product" widget="integer" placeholder="0" />
            </xpath>
        </field>
    </record>

    <record id="product_template_tree_view_pos_sort" model="ir.ui.view">
        <field name="name">product.template.tree.pos.sort</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="acs_sort_pos_product" optional="hide" />
            </xpath>
        </field>
    </record>

    <record id="product_product_tree_view_pos_sort" model="ir.ui.view">
        <field name="name">product.product.tree.pos.sort</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_product_tree_view" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="acs_sort_pos_product" optional="hide" />
            </xpath>
        </field>
    </record>

    <record id="product_product_form_view_pos_sort" model="ir.ui.view">
        <field name="name">product.product.form.pos.sort</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='type']" position="after">
                <field name="acs_sort_pos_product" widget="integer" placeholder="0" />
            </xpath>
        </field>
    </record>
</odoo>