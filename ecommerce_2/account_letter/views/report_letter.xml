<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="report_letter_document">
            <t t-call="web.external_layout">
                <t t-set="o" t-value="o.with_context(lang=o.partner_id.lang)" />
                <div class="page">
                    <div class="row">
                        <div name="invoice_address" class="col-xs-5 col-xs-offset-7">
                            <address t-field="o.partner_id"
                                t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": True}' />
                            <div t-if="o.partner_id.vat" class="mt16"><t t-esc="o.company_id.country_id.vat_label or 'TIN'"/>: <span t-field="o.partner_id.vat"/></div>
                        </div>
                    </div>

                    <h2>
                    	<span>Bill of Exchange</span>
                        <span t-field="o.number"/>
                    </h2>

                    <div class="row mt32 mb32">
                        <div class="col-xs-2" t-if="o.name">
                            <strong>Description:</strong>
                            <p t-field="o.name"/>
                        </div>
                        <div class="col-xs-2" t-if="o.payment_date">
                            <strong>Date:</strong>
                            <p t-field="o.payment_date"/>
                        </div>
                        <div class="col-xs-2" t-if="o.date_due">
                            <strong>Due Date:</strong>
                            <p t-field="o.date_due"/>
                        </div>
                        <div class="col-xs-2" t-if="o.partner_id.ref">
                            <strong>Customer Code:</strong>
                            <p t-field="o.partner_id.ref"/>
                        </div>
                        <!--div name="reference" class="col-xs-2" t-if="o.reference">
                            <strong>Reference:</strong>
                            <p t-field="o.reference"/>
                        </div-->
                    </div>

                    <table class="table table-condensed" name="letter_table">
                    	<tr>
                    		<td>
                    			Letter Amount
                    		</td>
                    		<td class="text-right">
                    			<span t-field="o.amount"/>
                    		</td>
                    	</tr>
                    	<tr>
                    		<td colspan="2">
                    			It's: <span t-esc="o.get_amount_in_letter()"/>
                    		</td>
                    	</tr>
                    </table>

                    <t t-if="o.invoice_ids">
                    	<p><strong>Invoices To Paid</strong></p>
	                    <table class="table table-condensed" name="invoice_line_table">
	                        <thead>
	                            <tr>
	                                <th>Description</th>

	                                <th class="text-right">Amount</th>
	                            </tr>
	                        </thead>
	                        <tbody class="invoice_tbody">
	                            <tr t-foreach="o._get_payments_invoice_vals()" t-as="l">
	                                <td>
	                                	<span t-esc="l.get('name') or ''"/>
	                                </td>
	                                <td class="text-right" id="subtotal">
	                                    <span t-esc="l.get('amount') or 0.0" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
	                                </td>
	                            </tr>
	                        </tbody>
	                    </table>
	                </t>
                    <!--p t-if="o.comment">
                        <span t-field="o.comment"/>
                    </p-->
                </div>
            </t>
        </template>


        <template id="report_letter">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <t t-call="account_letter.report_letter_document" t-lang="o.partner_id.lang"/>
                </t>
            </t>
        </template>

        <report
            id="action_report_letter"
            model="account.letter"
            string="Letter Report"
            report_type="qweb-pdf"
            name="account_letter.report_letter"
            file="account_letter.report_letter"
        />
    </data>
</odoo>
