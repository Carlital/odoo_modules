msgid "${object.company_id.name} Letter (Ref ${object.number or object.name or 'n/a'})"
msgstr "${object.company_id.name} Letra (Ref ${object.number or object.name or 'n/a'})"

#. module: account_letters
#: model:ir.ui.view,arch_db:account_letters.report_letter_all_document
msgid "<b>TOTAL</b>"
msgstr "<b>TOTAL</b>"

#. module: account_letters
#: model:mail.template,body_html:account_letters.email_template_edi_letter
msgid ""
"<div>\n"
"<p>Dear ${object.partner_id.name}\n"
"\n"
"% if object.partner_id.parent_id:\n"
"    (<i>${object.partner_id.parent_id.name}</i>)\n"
"% endif\n"
",</p>\n"
"<p>Here is, in attachment, your \n"
"% if object.number:\n"
"Letter <strong>${object.number}</strong>\n"
"% else:\n"
"letter\n"
"% endif\n"
"\n"
"amounting in <strong>${format_amount(object.amount_total, object.currency_id)}</strong>\n"
"from ${object.company_id.name}.\n"
"</p>\n"
"\n"
"    <br/><br/>\n"
"\n"
"% if object.state=='paid':\n"
"    <p>This invoice is already paid.</p>\n"
"% else:\n"
"    <p>Please remit payment at your earliest convenience.</p>\n"
"% endif\n"
"\n"
"<p>Thank you,</p>\n"
"<p style=\"color:#888888\">\n"
"% if object.user_id and object.user_id.signature:\n"
"    ${object.user_id.signature | safe}\n"
"% endif\n"
"</p>\n"
"</div>"
msgstr ""
"<div>\n"
"<p>Estimado ${object.partner_id.name}\n"
"\n"
"% if object.partner_id.parent_id:\n"
"    (<i>${object.partner_id.parent_id.name}</i>)\n"
"% endif\n"
",</p>\n"
"<p>Remitimos adjunta su  \n"
"% if object.number:\n"
"Letra <strong>${object.number}</strong>\n"
"% else:\n"
"Letra\n"
"% endif\n"
"\n"
"por un importe de <strong>${format_amount(object.amount_total, object.currency_id)}</strong>\n"
"efectuado por ${object.company_id.name}.\n"
"</p>\n"
"\n"
"    <br/><br/>\n"
"\n"
"% if object.state=='paid':\n"
"    <p>Esta Letra ya está pagada.</p>\n"
"% else:\n"
"    <p>Por favor remita el pago lo antes que pueda.</p>\n"
"% endif\n"
"\n"
"<p>Gracias,</p>\n"
"<p style=\"color:#888888\">\n"
"% if object.user_id and object.user_id.signature:\n"
"    ${object.user_id.signature | safe}\n"
"% endif\n"
"</p>\n"
"</div>"

