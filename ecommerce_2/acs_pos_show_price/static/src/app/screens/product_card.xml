<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="acs_pos_show_price.ProductCard" t-inherit="point_of_sale.ProductCard" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('product-content')]" position="attributes">
            <attribute name="class">product-content d-flex flex-column px-2 justify-content-between rounded-bottom rounded-3 flex-shrink-1</attribute>
        </xpath>
        <xpath expr="//div[hasclass('product-content')]" position="inside">
            <span><t t-esc="props.product.price_base"/></span>
        </xpath>
        
    </t>
</templates>
