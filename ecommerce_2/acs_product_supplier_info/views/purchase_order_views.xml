<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="purchase_order_form_inherit_acs_stock_condition" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.acs.stock.condition</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']//list//field[@name='product_qty']"
                position="after">
                <field name="stock_condition" />
            </xpath>
        </field>
    </record>

</odoo>