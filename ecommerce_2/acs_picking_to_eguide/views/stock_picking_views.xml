                </attribute>
            </xpath>
        </field>
    </record> -->
    <!-- Vista heredada para controlar acceso -->
    <record id="view_pe_electronic_guide_tree_custom" model="ir.ui.view">
        <field name="name">pe.electronic.guide.tree.custom</field>
        <field name="model">pe.electronic.guide</field>
        <field name="inherit_id" ref="l10n_pe_eguide_advanced.view_pe_electronic_guide_list" />
        <field name="arch" type="xml">
            <xpath expr="//tree | //list" position="attributes">
                <!-- Control de creación basado en el campo personalizado -->
                <attribute name="create">user.ver_boton_crear_guias</attribute>
                <!-- Mantener otros permisos intactos -->
                <attribute name="edit">true</attribute>
                <attribute name="delete">true</attribute>
            </xpath>
            <xpath expr="//field[@name='response']" position="after">
                <field name="invoice_id" string="Factura" />
            </xpath>
        </field>
    </record>

    <!-- También controlar en la vista form si existe -->
    <record id="view_pe_electronic_guide_form_custom" model="ir.ui.view">
        <field name="name">pe.electronic.guide.form.custom</field>
        <field name="model">pe.electronic.guide</field>
        <field name="inherit_id" ref="l10n_pe_eguide_advanced.view_pe_electronic_guide_form" />
        <field name="arch" type="xml">
            <xpath expr="//form" position="attributes">
                <attribute name="create">user.ver_boton_crear_guias</attribute>
            </xpath>
            <xpath expr="//field[@name='transport_mode']" position="after">
                <field name="invoice_id"
                    options="{'no_create': True, 'no_create_edit': True}"
                    placeholder="Relacionar factura..." />
            </xpath>
        </field>
    </record>

</odoo>