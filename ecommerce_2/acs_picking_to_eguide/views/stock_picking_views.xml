<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_picking_form_inherit_eguide" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit.eguide</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form" />
        <field name="arch" type="xml">

            <!-- CORRECCIÓN: Agregar el Smart Button en la oe_button_box -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_eguide_tree" type="object" string="Guías"
                    icon="fa-file-text-o"
                    class="oe_stat_button">
                    <field name="eguide_count" widget="statinfo" string="Guías" />
                </button>
            </xpath>

            <!-- CORRECCIÓN: Agregar el botón Crear Guía después del botón Return -->
            <xpath expr="//button[@name='620']" position="after">
                <button name="action_create_eguide" type="object" string="Crear Guía"
                    class="btn btn-primary" invisible="state != 'done'" />
            </xpath>

        </field>
    </record>

    <record id="view_picking_form_hide_peruvian_customization" model="ir.ui.view">
        <field name="name">stock.picking.form.hide.peruvian.customization</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="l10n_pe_eguide.view_picking_form" />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='peruvian_customization']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>

