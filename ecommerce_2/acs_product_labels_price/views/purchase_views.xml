<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="purchase_order_form_acs_purchase_labels" model="ir.ui.view">
        <field name="name">purchase.order.form.acs.purchase</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='button_unlock']" position="after">
                <button name="%(acs_product_labels_price.acs_product_labels_price_barcode_action)d" string="Etiquetas" type="action" class="btn-primary"/>
            </xpath>
        </field>
    </record>

</odoo>
