<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_acs_product_labels_price_header2" model="ir.ui.view">
        <field name="name">view.acs.product.labels.price.header2</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="%(acs_product_labels_price_barcode_action)d" string="Etiquetas" type="action" class="btn-primary"/>
            </xpath>
        </field>
    </record>
    
    <record id="view_acs_product_labels_price_header3" model="ir.ui.view">
        <field name="name">view.acs.product.labels.price.header3</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="%(acs_product_labels_price_barcode_action)d" string="Etiquetas" type="action" class="btn-primary"/>
            </xpath>
        </field>
    </record>
    
</odoo>
