<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="acs_product_labels_price_barcode" model="ir.ui.view">
        <field name="name">acs.product.labels.price.barcode</field>
        <field name="model">barcode.tag.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <group>
                        <field name="qty"/>
                    </group>
                </group>
                <footer>
                    <button string='Etiquetas código de barras' name="print_barcode" type="object" class="btn-primary"/>
                    <button string='Etiquetas de precios' name="print_price" type="object" class="btn-primary"/>
                    <button string="Cancelar" class="btn-default" special="cancel"/>
                </footer>
           </form>
        </field>
    </record>

    <record id="acs_product_labels_price_barcode_action" model="ir.actions.act_window">
        <field name="name">Imprimir Etiquetas</field>
        <field name="res_model">barcode.tag.wizard</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="acs_product_labels_price_barcode"/>
        <field name="target">new</field>
    </record>

</odoo>
