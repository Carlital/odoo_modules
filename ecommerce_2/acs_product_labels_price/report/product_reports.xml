<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        
        <report
            id="report_product_label_price_acs"
            string="Etiquetas de precios"
            model="product.product"
            report_type="qweb-pdf"
            name="acs_product_labels_price.report_productlabelprice_acs"
            file="acs_product_labels_price.report_productlabelprice_acs"
        />

        <report
            id="report_product_template_label_price_acs"
            string="Etiquetas de precios"
            model="product.template"
            report_type="qweb-pdf"
            name="acs_product_labels_price.report_producttemplatelabelprice_acs"
            file="acs_product_labels_price.report_producttemplatelabelprice_acs"
        />

        <template id="report_simple_labelprice_acs">
            <div class="col-xs-4" style="padding:0;">
                
                <table style="border-spacing:0;margin-bottom:0;height:122px;" class="table"> 
                    <tr style="border-bottom-style: none;">
                        <td width="80%" style="text-align: center; vertical-align: middle;  font-size: 24px;" rowspan="2">
                            <strong t-field="product.barcode"/>
                        </td>
                        <td colspan="2" style="text-align: right; font-size: 12px; border-bottom-style: none;">
                            <span t-field="product.qty_last_purchase" t-options='{"widget": "integer"}'/>
                        </td>
                    </tr>
                    <tr style="border-bottom-style: none;">
                        <td></td>
                        <td style="text-align: right; font-size: 12px; border-bottom-style: none;">
                            <span t-field="product.qty_available" t-options='{"widget": "integer"}'/>
                        </td>
                    </tr>
                    <tr>
                        <td><span t-field="product.default_code"/></td>
                        <td style="text-align: right;">
                            <span t-if="product.date_last_purchase" t-field="product.date_last_purchase"  t-field-options='{"format": "MM"}'/>
                        </td>
                        <td style="text-align: right;">
                    
                            <span style="display:inline;" t-field="product.price_last_purchase"/>
                            <span style="display:inline;" t-if="product.date_last_purchase" t-field="product.date_last_purchase"  t-field-options='{"format": "YY"}'/>
 
                        </td>
                    </tr>
                    <tr>
                        <td colspan="3" style="border: 1px solid black; text-align: center;">
                            <strong t-field="product.name"/>
                        </td>
                    </tr>
                    <tr>
                        <td style="text-align: center; font-size: 30px;" colspan="3">
                            S/ <strong t-field="product.standard_price"/>
                        </td>
                      </tr>
                    <tr style="background: yellow;">
                        <strong>
                            <td style="text-align: left;">
                                PRECIO X MAYOR S/
                            </td>
                            <td colspan="2" style="text-align: right;">
                                500
                            </td>
                        </strong>
                    </tr>
                    
                </table>





                <!--
