<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_users_form_picking_conversion" model="ir.ui.view">
        <field name="name">res.users.form.picking.conversion</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form" />
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Permisos Adicionales" name="additional_permissions">
                    <group>
                        <field name="allow_picking_conversion" />
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>