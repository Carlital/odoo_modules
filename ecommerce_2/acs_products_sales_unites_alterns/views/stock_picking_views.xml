<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Vista de formulario para stock.picking -->
    <record id="stock_picking_form_view_conversion" model="ir.ui.view">
        <field name="name">stock.picking.form.conversion</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form" />
        <field name="arch" type="xml">
            <!-- Agregar campos invisibles para uso en condiciones -->
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="has_convertible_products" invisible="1" />
                <field name="is_converted" invisible="1" />
                <field name="can_convert" invisible="1" />
            </xpath>

            <!-- Agregar botones en el header -->
            <xpath expr="//button[@name='action_cancel']" position="after">
                <button name="action_convert_to_meters"
                    string="Convertir"
                    type="object"
                    class="btn-primary"
                    invisible="not has_convertible_products or not can_convert"
                    confirm="¿Estás seguro de que deseas convertir los productos de peso a metros lineales?"
                    help="Convertir productos de peso a metros lineales" />

                <button name="action_view_conversion_pickings"
                    string="Ver Conversiones"
                    type="object"
                    class="btn-secondary"
                    invisible="not is_converted"
                    help="Ver pickings generados en la conversión" />
            </xpath>

            <!-- Agregar información en la página Additional Info -->
            <xpath expr="//page[@name='extra']" position="inside">
                <group string="Información de Conversión" name="conversion_info">
                    <group>
                        <field name="is_converted" />
                        <field name="has_convertible_products" />
                        <field name="can_convert" />
                        <field name="conversion_out_picking_id"
                            invisible="not conversion_out_picking_id" />
                        <field name="conversion_in_picking_id"
                            invisible="not conversion_in_picking_id" />
                    </group>
                </group>
            </xpath>
        </field>
    </record>

