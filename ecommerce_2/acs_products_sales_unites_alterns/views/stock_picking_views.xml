    <!-- Acción para pickings con productos convertibles -->
    <record id="action_picking_convertible" model="ir.actions.act_window">
        <field name="name">Recepciones Convertibles</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">stock.picking</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('picking_type_code', '=', 'incoming'), '|',
            ('has_convertible_products', '=', True), ('state', '=', 'converted')]</field>
        <field name="context">{'search_default_has_convertible': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                ¡No hay recepciones con productos convertibles!
            </p>
            <p>
                Aquí aparecerán las recepciones validadas que contengan productos
                configurados para conversión de peso a metros lineales.
            </p>
        </field>
    </record>

    <menuitem id="menu_picking_convertible"
        name="Recepciones Convertibles"
        parent="stock.menu_stock_warehouse_mgmt"
        action="action_picking_convertible"
        sequence="25" />

