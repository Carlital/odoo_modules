<odoo>
    <record id="res_users_view_form_acs" model="ir.ui.view">
        <field name="name">res.users.view.form.acs</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='preferences']" position="inside">
                <group string="Permisos de Órdenes de Compra">
                    <field name="acs_po_no_confirm"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
