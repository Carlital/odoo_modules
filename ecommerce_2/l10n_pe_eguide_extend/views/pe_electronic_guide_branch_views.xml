<odoo>
  <data>
    <!-- explicit list view definition -->
    <record model="ir.ui.view" id="view_pe_electronic_guide_branch_tree">
      <field name="name">pe.electronic.guide.branch.tree</field>
      <field name="model">pe.electronic.guide.branch</field>
      <field name="arch" type="xml">
        <list string="Electronic Guide">
          <field name="name"/>
            <field name="code"/>
          <field name="state_id" />
          <field name="province_id" />
          <field name="district_id" />
          <field name="street"/>
          <field name="company_id"/>
        </list>
      </field>
    </record>

    <record id="view_pe_electronic_guide_branch_form" model="ir.ui.view">
      <field name="name">pe.electronic.guide.branch.form</field>
      <field name="model">pe.electronic.guide.branch</field>
      <field name="arch" type="xml">
          <form>
            <header>

            </header>
            <sheet string="Branch">
                <div class="oe_button_box" name="button_box">
                    <button name="toggle_active" type="object" class="oe_stat_button" icon="fa-archive">
                        <field name="active" widget="boolean_button" options='{"terminology": "archive"}'/>
                    </button>
                </div>
              <h1 class="mt0">
                  <field name="name" placeholder="Lima Branch" class="oe_inline" />
              </h1>

              <group>
                <group>
                  <field name="country_id" invisible="True" options='{"no_open": True, "no_create": True}'/>
                  <field name="state_id" domain="[('country_id','=',country_id)]" options='{"no_open": True, "no_create": True}'/>
                  <field name="province_id" domain="[('state_id','=',state_id)]" options='{"no_open": True, "no_create": True}'/>
                  <field name="district_id" domain="[('province_id','=',province_id)]" options='{"no_open": True, "no_create": True}'/>

                </group>
                 <group>
                  <field name="code" placeholder='Example "0000"' />
                  <field name="street" />
                  <field name="company_id"/>
                </group>
              </group>

            </sheet>
            <div class="oe_chatter">
                <field name="message_follower_ids" widget="mail_followers" groups="base.group_user"/>
                <field name="activity_ids" widget="mail_activity"/>
                <field name="message_ids" widget="mail_thread"/>
            </div>
          </form>
      </field>
    </record>

    <!-- actions opening views on models -->
    <record model="ir.actions.act_window" id="action_pe_electronic_guide_branch">
      <field name="name">Branch</field>
      <field name="res_model">pe.electronic.guide.branch</field>
      <field name="view_mode">tree,form</field>
      <field name="view_id" ref="view_pe_electronic_guide_branch_tree"/>
      <!--field name="context">{'search_default_dashboard':1}</field -->
      <field name="help" type="html">
          <p>
              This is the Electronic Guide Branch.
          </p>
      </field>
    </record>


  </data>
</odoo>