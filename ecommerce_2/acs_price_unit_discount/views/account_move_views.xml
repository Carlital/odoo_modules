<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_move_form_pdesc" model="ir.ui.view">
        <field name="name">account.move.form.pdesc</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <!-- Añadir campo en la vista de árbol de líneas de factura -->
            <xpath expr="//field[@name='invoice_line_ids']/list//field[@name='discount']"
                position="after">
                <field name="invoice_line_pdesc" string="P.Unit. Desc" />
            </xpath>
            <!-- Añadir campo en la vista de formulario de líneas de factura -->
            <xpath expr="//field[@name='invoice_line_ids']/form//field[@name='price_unit']"
                position="after">
                <field name="invoice_line_pdesc" string="P.Unit. Desc" />
            </xpath>
            <!-- Resaltar en rojo si el precio con descuento es menor que 0 -->
            <xpath expr="//field[@name='invoice_line_ids']/list" position="attributes">
                <attribute name="decoration-danger">invoice_line_pdesc &lt; 0</attribute>
            </xpath>
        </field>
    </record>
</odoo>