<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View (editable list) -->
    <record id="view_res_partner_rubro_tree" model="ir.ui.view">
        <field name="name">res.partner.rubro.tree</field>
        <field name="model">res.partner.rubro</field>
        <field name="arch" type="xml">
            <list string="Rubros Empresariales" editable="bottom">
                <field name="name" />
                <field name="active" widget="boolean_toggle" />
            </list>
        </field>
    </record>

    <!-- Action -->
    <record id="action_res_partner_rubro" model="ir.actions.act_window">
        <field name="name">Rubros Empresariales</field>
        <field name="res_model">res.partner.rubro</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crea un nuevo rubro empresarial.
            </p>
            <p>
                Los rubros te permiten clasificar a tus clientes y contactos por su sector de
                actividad.
            </p>
        </field>
    </record>

    <!-- Menu Item -->
    <menuitem id="menu_res_partner_rubro" name="Rubros Empresariales"
        action="action_res_partner_rubro"
        parent="contacts.res_partner_menu_config" sequence="10" />

</odoo>