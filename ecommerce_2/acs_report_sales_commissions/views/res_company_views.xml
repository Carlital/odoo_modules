<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Heredar la vista de configuración de la compañía -->
    <record id="view_company_form_inherit_commission" model="ir.ui.view">
        <field name="name">res.company.form.inherit.commission</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form" />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='branches']" position="inside">
                <group string="Configuración de Comisiones" name="commission_settings">
                    <group>
                        <group>
                            <field name="acs_commission" widget="percentage" />
                            <field name="acs_sales_meta_monthly_usd" />
                            <field name="currency_usd_id" invisible="1" />
                        </group>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

</odoo>