<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista Formulario del Wizard -->
    <record id="view_sale_extended_report_excel_wizard_form" model="ir.ui.view">
        <field name="name">sale.extended.report.excel.wizard.form</field>
        <field name="model">sale.extended.report.excel.wizard</field>
        <field name="arch" type="xml">
            <form string="Reporte de ventas extendido en excel">
                <p>Seleccione el rango de fechas para generar el reporte.</p>
                <group>
                    <group>
                        <field name="date_from" />
                    </group>
                    <group>
                        <field name="date_to" />
                    </group>
                </group>
                <footer>
                    <button name="action_export_excel" string="Exportar" type="object"
                        class="btn-primary" data-hotkey="q" />
                    <button string="Cancelar" class="btn-secondary" special="cancel" data-hotkey="z" />
                </footer>
            </form>
        </field>
    </record>

    <!-- Acción para abrir el Wizard -->
    <record id="action_sale_extended_report_excel_wizard" model="ir.actions.act_window">
        <field name="name">Reporte de ventas extendido en excel</field>
        <field name="res_model">sale.extended.report.excel.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="view_id" ref="view_sale_extended_report_excel_wizard_form" />
    </record>

    <!-- Ítem de Menú -->
    <menuitem id="menu_sale_extended_report_excel" name="RVE Excel" parent="sale.menu_sale_report"
        action="action_sale_extended_report_excel_wizard" sequence="21" />
</odoo>