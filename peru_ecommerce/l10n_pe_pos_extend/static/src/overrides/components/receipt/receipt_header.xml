<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="l10n_pe_pos_extend.ReceiptHeader" t-inherit="point_of_sale.ReceiptHeader" t-inherit-mode="extension">
        <xpath expr="//t[@t-if='props.data.company.phone']" position="before">
            <t t-if="props.data.company.street">
                <div><t t-esc="props.data.company.street" /></div>
            </t>
            <t t-if="props.data.company.l10n_pe_district">
                <div>
                    <t t-esc="props.data.company.l10n_pe_district ? props.data.company.l10n_pe_district[1]: ''" />
                    <t t-esc="props.data.company.city_id ? ', ' + props.data.company.city_id[1]: ''" />
                    <t t-esc="props.data.company.state_id ? ', ' + props.data.company.state_id[1]: ''" />
                    <t t-esc="props.data.company.zip ? ', ' + props.data.company.zip: ''" />
                </div>
            </t>
        </xpath>
        <xpath expr="//div[@t-if='props.data.header']" position="after">
            <div>--------------------------------</div>
            <div class="pos-receipt-partner">
                <div>Date: <t t-esc="props.data.invoice_date" /></div>
                <div t-if="props.data.partner">
                    <t t-if="props.data.partner.name">
                        <div><t t-esc="props.data.partner.name" /></div>
                    </t>
                    <t t-if="props.data.partner.vat">
                        <div>
                            <t t-esc="props.data.partner.l10n_latam_identification_type_id ? props.data.partner.l10n_latam_identification_type_id[1]: ''" />
                            <t t-esc="props.data.partner.vat"/>
                        </div>
                    </t>
                    <t t-if="props.data.partner.street">
                        <div>Street: <t t-esc="props.data.partner.street || ''"/></div>
                    </t>
                    <t t-if="props.data.partner.l10n_pe_district">
                        <div>
                            <t t-esc="props.data.partner.l10n_pe_district ? props.data.partner.l10n_pe_district[1]: ''" />
                            <t t-esc="props.data.partner.city_id ? ', ' + props.data.partner.city_id[1]: ''" />
                            <t t-esc="props.data.partner.state_id ? ', ' + props.data.partner.state_id[1]: ''" />
                            <t t-esc="props.data.partner.country_id ? ', ' + props.data.partner.country_id[1]: ''" />
                            <t t-esc="props.data.partner.zip ? ', ' + props.data.partner.zip: ''" />
                        </div>
                    </t>
                </div>
                <div>
                    Currency: <t t-esc="props.data.currency.name"/>
                </div>
            </div>
        </xpath>
    </t>
</templates>
