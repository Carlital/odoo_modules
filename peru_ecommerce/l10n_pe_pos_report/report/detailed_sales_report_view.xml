<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>
        <template id="report_detailed_sales_report">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <t t-call="web.internal_layout">
                        <div class="page">
                            <div class="row" id="hash_header">
                                <div class="col-12 text-center">
                                    <h2 style="font-size: 20px;">Detailed sales record</h2>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-12 text-center">
                                    <h3 style="font-size: 16px;">Session <span t-field="o.start_at"/> - <span t-field="o.stop_at"/></h3>
                                    <br />
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-12" style="font-size: 12px; padding: 2px 2px 2px 2px !important;">
                                    <table class="table table-bordered">
                                        <thead style="display: table-row-group">
                                            <tr>
                                                <th class="text-center" scope="col">Date</th>
                                                <th class="text-center" scope="col">Number</th>
                                                <th class="text-center" scope="col">Partner</th>
                                                <th class="text-center" scope="col">Taxed operations</th>
                                                <th class="text-center" scope="col">Exonerated</th>
                                                <th class="text-center" scope="col">Unaffected</th>
                                                <th class="text-center" scope="col">IGV</th>
                                                <th class="text-center" scope="col">Total</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-foreach="data[o.id]['lines']" t-as="result">
                                                <tr>
                                                    <td class="text-center">
                                                        <span t-esc="result['invoice_date']"/>
                                                    </td>
                                                    <td class="text-center">
                                                        <span t-esc="result['name']"/>
                                                    </td>
                                                    <td class="text-center">
                                                        <span t-esc="result['partner']"/>
                                                    </td>
                                                    <td class="text-right">
                                                        <span t-esc="result['amount_igv']"/>
                                                    </td>
                                                    <td class="text-right">
                                                        <span t-esc="result['amount_exo']"/>
                                                    </td>
                                                    <td class="text-right">
                                                        <span t-esc="result['amount_ina']"/>
                                                    </td>
                                                    <td class="text-right">
                                                        <span t-esc="result['igv']"/>
                                                    </td>
                                                    <td class="text-right">
                                                        <span t-esc="result['amount']"/>
                                                    </td>
                                                </tr>
                                            </t>
                                            <tr style="font-weight: bold;">
                                                <td class="text-center" colspan="3">
                                                    Total
                                                </td>
                                                <td class="text-right">
                                                    <span t-esc="data[o.id]['base_igv']"/>
                                                </td>
                                                <td class="text-right">
                                                    <span t-esc="data[o.id]['base_exo']"/>
                                                </td>
                                                <td class="text-right">
                                                    <span t-esc="data[o.id]['base_ina']"/>
                                                </td>
                                                <td class="text-right">
                                                    <span t-esc="data[o.id]['igv']"/>
                                                </td>
                                                <td class="text-right">
                                                    <span t-esc="data[o.id]['total']"/>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-6" style="font-size: 12px; padding: 2px 2px 2px 2px !important;">
                                    <b>Summary by Document</b>
                                    <table class="table table-bordered">
                                        <thead style="display: table-row-group">
                                            <tr>
                                                <th>Document Type</th>
                                                <th>Amount Total</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-foreach="data[o.id]['totals']" t-as="total">
                                                <tr>
                                                    <td class="text-center">
                                                        <span t-esc="total['name']"/>
                                                    </td>
                                                    <td class="text-right">
                                                        <span t-esc="total['amount_total']"/>
                                                    </td>
                                                </tr>
                                            </t>
                                            <tr style="font-weight: bold;">
                                                <td class="text-center">
                                                    TOTAL
                                                </td>
                                                <td class="text-right">
                                                    <span t-esc="data[o.id]['amount_total']"/>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>

                        </div>
                    </t>
                </t>
            </t>
        </template>
    </data>
</odoo>
