<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="l10n_pe_pos_ticket.ReceiptHeader" t-inherit="point_of_sale.ReceiptHeader" t-inherit-mode="extension">
    <xpath expr="//img[@class='pos-receipt-logo']/following-sibling::br[1]" position="replace"></xpath>
    <xpath expr="//div[@class='pos-receipt-contact']/following-sibling::br[2]" position="replace"></xpath>
    <xpath expr="//div[hasclass('pos-receipt-contact')]" position="replace">
    <div style="text-align:center; font-weight: bold; font-size:14px;">
        <t t-if="props.data.pe_move_name!=''">
                <t t-esc="props.data.pe_invoice_name || ''" /> <br />
                <t t-esc="props.data.pe_move_name || ''" />
            </t>
    </div>        
        <t t-if="props.data.table">
			<div style="text-align:center; font-weight: bold; font-size:14px;">
			<t t-esc="props.data.table" />
			</div>
           	</t>
        <div class="pos-receipt-contact" style="text-align:center;font-size:14px;">
             <t t-if="props.data.company.partner_id?.[1]">
                <div><b><t t-esc="props.data.company.partner_id[1]" /></b></div>
            </t>
            <t t-if="props.data.company.phone">
                <div><b>Tel: </b><t t-esc="props.data.company.phone" /></div>
            </t>
            <t t-if="props.data.company.vat">
                <div><b><t t-esc="props.data.company.country?.vat_label || 'Tax ID'"/>: </b> <t t-esc="props.data.company.vat" /></div>
            </t>
            <div t-if="props.data.company.website" t-esc="props.data.company.street" />
            
            <div t-if="props.data.header" style="white-space:pre-line" t-esc="props.data.header" />
                <div style="text-align:left">
                    <div style="text-align:center"> =============== </div>
                    <t t-if="props.data.partner.name">
                        <div><b>Cliente: <t t-esc="props.data.partner.name" /></b></div>
                    </t>
                    <t t-if="props.data.partner.vat">
                        <div>
                            <b><t t-esc="props.data.partner.l10n_latam_identification_type_id ? props.data.partner.l10n_latam_identification_type_id[1]: ''" />: </b>
                            <t t-esc="props.data.partner.vat"/>
                            
                        </div>
                    </t>
                    <t t-if="props.data.partner.street">
                        <div><b>Dirección: </b><t t-esc="props.data.partner.street || ''"/></div>
                    </t>
                    <t t-if="props.data.partner.l10n_pe_district">
                        <div>
                            <t t-esc="props.data.partner.l10n_pe_district ? props.data.partner.l10n_pe_district[1]: ''" />
                            <t t-esc="props.data.partner.city_id ? ', ' + props.data.partner.city_id[1]: ''" />
                            <t t-esc="props.data.partner.state_id ? ', ' + props.data.partner.state_id[1]: ''" />
                            <t t-esc="props.data.partner.country_id ? ', ' + props.data.partner.country_id[1]: ''" />
                            <t t-esc="props.data.partner.zip ? ', ' + props.data.partner.zip: ''" />
                        </div>
                    </t>

                    <div t-if="props.data.cashier" class="cashier">
                        <div><b>Atendido por: </b><t t-esc="props.data.cashier" /></div>
                        
                        <div id="order-date"><b>Fecha: </b><t t-set="formattedDate" t-value="(new Date(props.data.invoice_date)).toLocaleDateString('es-ES', { day: '2-digit', month: '2-digit', year: 'numeric' })"/><t t-esc="formattedDate"/></div>
                        <!--
                        <div id="order-date"><b>Fecha: </b><t t-esc="props.data.invoice_date" /></div>-->
                    </div>
                </div>
        </div>
        
    </xpath>    
    </t>
</templates>
