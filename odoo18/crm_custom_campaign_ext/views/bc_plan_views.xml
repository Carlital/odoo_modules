<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- bc.plan.line: vista list -->
    <record id="view_bc_plan_line_list" model="ir.ui.view">
        <field name="name">bc.plan.line.list</field>
        <field name="model">bc.plan.line</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="titulo"/>
                <field name="detalle"/>
                <field name="tipo"/>
                <field name="icon_hint"/>
                <field name="icon_ids" widget="many2many_binary" options="{&quot;no_create&quot;: false}"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- bc.plan.line: formulario -->
    <record id="view_bc_plan_line_form" model="ir.ui.view">
        <field name="name">bc.plan.line.form</field>
        <field name="model">bc.plan.line</field>
        <field name="arch" type="xml">
            <form string="Bloque del Plan">
                <sheet>
                    <group>
                        <field name="plan_id"
                               groups="base.group_system,crm_custom_lead.group_jefe_operaciones"/>
                        <field name="sequence" widget="handle"
                               groups="base.group_system,crm_custom_lead.group_jefe_operaciones"/>
                        <field name="titulo"/>
                        <field name="detalle"/>
                        <field name="tipo"/>
                        <field name="icon_hint"/>

                        <!-- Editable (selección de iconos existentes) para Admin / Jefe de Operaciones -->
                        <field name="icon_ids"
                               widget="many2many_tags"
                               groups="base.group_system,crm_custom_lead.group_jefe_operaciones"
                               options="{'no_create': False}"/>

                        <!-- Solo lectura: miniaturas para usuarios normales -->
                        <field name="icon_ids"
                               widget="many2many_binary"
                               readonly="1"
                               groups="base.group_user"
                               options="{'no_create': True}"/>

                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- bc.plan: vista list -->
    <record id="view_bc_plan_list" model="ir.ui.view">
        <field name="name">bc.plan.list</field>
        <field name="model">bc.plan</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence"/>
                <field name="name"/>
                <field name="subcampaign_id"/>
                <field name="price_with_tax"/>
                <field name="headline"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- bc.plan: vista form -->
    <record id="view_bc_plan_form" model="ir.ui.view">
        <field name="name">bc.plan.form</field>
        <field name="model">bc.plan</field>
        <field name="arch" type="xml">
            <form string="Plan Comercial">
                <sheet>

                    <group>
                        <field name="subcampaign_id"/>
                        <field name="sequence"
                               groups="base.group_system,crm_custom_lead.group_jefe_operaciones"/>
                        <field name="name"/>
                        <field name="currency_id"/>
                        <field name="price_no_tax"/>
                        <field name="price_with_tax"/>
                        <field name="headline"/>
                        <field name="active"/>
                    </group>

                    <notebook>
                        <page string="Bloques">
                            <!-- Editable solo Admin / Jefe de Operaciones -->
                            <field name="line_ids"
                                   mode="list,form"
                                   groups="base.group_system,crm_custom_lead.group_jefe_operaciones"
                                   context="{
                                       'tree_view_ref': 'crm_custom_campaign_ext.view_bc_plan_line_list',
                                       'form_view_ref': 'crm_custom_campaign_ext.view_bc_plan_line_form'
                                   }"
                                   editable="bottom"
                            />

                        </page>
                    </notebook>

                </sheet>
            </form>
        </field>
    </record>

    <!-- bc.plan: vista kanban (tarjeta comercial) -->
    <record id="view_bc_plan_kanban" model="ir.ui.view">
        <field name="name">bc.plan.kanban</field>
        <field name="model">bc.plan</field>
        <field name="arch" type="xml">
            <kanban class="o_bc_plan_kanban o_kanban_small_column">

                <!-- declarar campos usados -->
                <field name="name"/>
                <field name="headline"/>
                <field name="price_with_tax"/>
                <field name="currency_id"/>
                <field name="active"/>
                <field name="subcampaign_id"/>
                <field name="line_ids"/>

                <templates>
                    <t t-name="kanban-box">
                        <div class="o_bc_card"
                             style="
                                border:1px solid #d0d0d0;
                                border-radius:8px;
                                padding:12px;
                                width:320px;
                                background-color:#fff;
                                box-shadow:0 2px 4px rgba(0,0,0,.05);
                             ">

                            <!-- Header -->
                            <div style="
                                display:flex;
                                justify-content:space-between;
                                align-items:flex-start;
                                margin-bottom:8px;
                            ">
                                <div>
                                    <div style="
                                        font-size:15px;
                                        font-weight:600;
                                        text-transform:uppercase;
                                    ">
                                        <t t-esc="record.name.value"/>
                                    </div>

                                    <t t-if="record.headline.value">
                                        <div style="font-size:13px; color:#555;">
                                            <t t-esc="record.headline.value"/>
                                        </div>
                                    </t>
                                </div>

                                <t t-if="record.price_with_tax.value">
                                    <div style="text-align:right;">
                                        <div style="
                                            font-size:16px;
                                            font-weight:700;
                                            line-height:1;
                                        ">
                                            <t t-esc="record.price_with_tax.value"/>
                                            <t t-if="record.currency_id.raw_value">
                                                <t t-esc="record.currency_id.value[1]"/>
                                            </t>
                                        </div>
                                        <div style="
                                            font-size:11px;
                                            color:#666;
                                            line-height:1.2;
                                        ">
                                            con IVA
                                        </div>
                                    </div>
                                </t>
                            </div>

                            <!-- Bloques del plan -->
                            <!-- caso con bloques -->
                            <ul t-if="record.line_ids.value.length"
                                style="
                                    margin:0;
                                    padding-left:18px;
                                    font-size:13px;
                                    line-height:1.4;
                                    color:#333;
                                ">
                                <t t-foreach="record.line_ids.value"
                                   t-as="ln"
                                   t-key="ln[0]">
                                    <li style="margin-bottom:4px;">
                                        <t t-esc="ln[1]"/>
                                    </li>
                                </t>
                            </ul>

                            <!-- caso sin bloques -->
                            <ul t-if="record.line_ids.value.length == 0"
                                style="
                                    margin:0;
                                    padding-left:18px;
                                    font-size:13px;
                                    line-height:1.4;
                                    color:#333;
                                ">
                                <li style="color:#999;">
                                    (Sin bloques definidos)
                                </li>
                            </ul>

                            <!-- Footer -->
                            <div style="
                                margin-top:10px;
                                font-size:12px;
                                color:#666;
                                display:flex;
                                justify-content:space-between;
                            ">
                                <div>
                                    <t t-if="record.active.value">
                                        <span style="color:#2e7d32; font-weight:600;">
                                            Activo
                                        </span>
                                    </t>
                                    <t t-if="record.active.value == false">
                                        <span style="color:#b71c1c; font-weight:600;">
                                            Inactivo
                                        </span>
                                    </t>
                                </div>

                                <div style="
                                    font-size:11px;
                                    color:#888;
                                    text-align:right;
                                ">
                                    <div>
                                        <t t-if="record.subcampaign_id.value">
                                            <t t-esc="record.subcampaign_id.value[1]"/>
                                        </t>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Acci�n -->
    <record id="action_bc_plan" model="ir.actions.act_window">
        <field name="name">Planes (BC)</field>
        <field name="res_model">bc.plan</field>
        <field name="view_mode">list,form,kanban</field>
        <field name="context">{'search_default_active': 1}</field>
    </record>

    <!-- Men� -->
    <menuitem id="menu_bc_plan"
              parent="crm_custom_lead.menu_crm_custom_campaign_root"
              action="action_bc_plan"
              sequence="60"/>

</odoo>



