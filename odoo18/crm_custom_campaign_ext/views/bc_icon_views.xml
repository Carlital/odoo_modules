<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id='view_bc_icon_list' model='ir.ui.view'>
        <field name='name'>bc.icon.list</field>
        <field name='model'>bc.icon</field>
        <field name='arch' type='xml'>
            <list string='Iconos'>
                <field name='sequence' widget='handle'/>
                <field name='name'/>
                <field name='active'/>
            </list>
        </field>
    </record>
    <record id='view_bc_icon_form' model='ir.ui.view'>
        <field name='name'>bc.icon.form</field>
        <field name='model'>bc.icon</field>
        <field name='arch' type='xml'>
            <form string='Icono'>
                <sheet>
                    <group>
                        <field name='name'/>
                        <field name='sequence'/>
                        <field name='image_128' widget='image' class='oe_avatar'/>
                        <field name='active'/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id='action_bc_icon' model='ir.actions.act_window'>
        <field name='name'>Iconos</field>
        <field name='res_model'>bc.icon</field>
        <field name='view_mode'>list,form</field>
        <field name='context'>{}</field>
    </record>
    <menuitem id='menu_bc_icon' name='Iconos' parent='crm_custom_lead.menu_crm_custom_campaign_root' action='action_bc_icon' sequence='40'/>
</odoo>


