<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Crear departamento Motorizados si no existe -->
        <record id="hr_department_motorizados" model="hr.department">
            <field name="name">Motorizados</field>
        </record>
        
        <!-- Función para configurar categoría Motorizado -->
