<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <!-- Etapas del negocio -->
    <record id="crm_stage_registro" model="crm.stage">
        <field name="name">Registro</field>
        <field name="sequence">1</field>
    </record>
    <record id="crm_stage_validacion" model="crm.stage">
        <field name="name">Validación</field>
        <field name="sequence">2</field>
    </record>
    <record id="crm_stage_post_venta" model="crm.stage">
        <field name="name">Post-Venta</field>
        <field name="sequence">3</field>
    </record>
    <record id="crm_stage_cerrado" model="crm.stage">
        <field name="name">Cerrado</field>
        <field name="sequence">4</field>
        <field name="is_won" eval="True"/>
    </record>
</odoo>


