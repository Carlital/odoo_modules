<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <!-- Hide Employees app from normal internal users by requiring HR roles -->
    <record id="hr.menu_hr_root" model="ir.ui.menu">
        <field name="groups_id" eval="[(6, 0, [ref('hr.group_hr_user'), ref('hr.group_hr_manager')])]"/>
    </record>

    <!-- Ensure Apps is only for system administrators -->
    <record id="base.menu_apps" model="ir.ui.menu">
        <field name="groups_id" eval="[(6, 0, [ref('base.group_system')])]"/>
    </record>
</odoo>

