<?xml version="1.0"?>
<odoo>
    <data>
        <record id="view_crm_lead_hotel_tour_form" model="ir.ui.view">
            <field name="name">view.hotel.tour.form</field>
            <field name="model">hotel.tour</field>
            <field name="arch" type="xml">
                <form >
                    <group>
                        <group>
                            <field name="name" required="1"/>
                            <field name="street"/>
                            <field name="phone"/>
                            <field name="country_id"/>
                        </group>
                    </group>
                </form>
            </field>
        </record>

        <record id="view_crm_lead_hotel_tour_tree" model="ir.ui.view">
            <field name="name">view.hotel.tour.tree</field>
            <field name="model">hotel.tour</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name"/>
                    <field name="street"/>
                    <field name="phone"/>
                    <field name="country_id"/>
                </tree>
            </field>
        </record>

        <record id="view_crm_lead_hotel_tour_action" model="ir.actions.act_window">
            <field name="name">Hoteles</field>
            <field name="res_model">hotel.tour</field>
            <!-- <field name="type">form</field> -->
            <field name="view_mode">tree,form</field>
            <field name="view_id" ref="view_crm_lead_hotel_tour_tree"/>
            <field name="target">current</field>
        </record>

        <menuitem
            id="view_crm_lead_hotel_tour_menu"
            action="view_crm_lead_hotel_tour_action"
            parent="crm.menu_crm_config_lead"/>
    </data>
</odoo>
