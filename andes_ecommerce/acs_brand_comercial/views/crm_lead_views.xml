<?xml version="1.0"?>
<odoo>

    <record id="view_create_opportunity_simplified" model="ir.ui.view">
        <field name="name">view.create.opportunity.simplified</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.quick_create_opportunity_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='priority']" position="after">
                <field name="brand_comercial_id" required="1"/>
            </xpath>
        </field>
    </record>

    <record id="view_crm_case_form_view_oppor" model="ir.ui.view">
        <field name="name">view.crm.case.form.view.oppor</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='lead']//field[@name='team_id']" position="after">
                <field name="is_salesman" invisible="1"/>
                <field name="brand_comercial_id" required="1" readonly="is_salesman == True" options='{"no_open": True, "no_create": True}'/>
            </xpath>
        </field>
    </record>

    <record id="view_sale_crm_case_form_view_oppor" model="ir.ui.view">
        <field name="name">view.sale.crm.case.form.view.opporr</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="sale_crm.crm_case_form_view_oppor"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_sale_quotations_new']" position="attributes">
                <attribute name="context">
                    {'search_default_partner_id': partner_id,                                   'default_partner_id': partner_id,                                   'default_team_id': team_id,                                   'default_campaign_id': campaign_id,                                   'default_medium_id': medium_id,                                   'default_source_id': source_id,
                    'default_brand_comercial_id': brand_comercial_id}
                </attribute>
            </xpath>

            <xpath expr="//button[@name='action_view_sale_quotation']" position="attributes">
                <attribute name="context">
                    {'default_partner_id': partner_id,
                    'search_default_draft': 1,
                    'search_default_sent': 1,
                    'default_brand_comercial_id': brand_comercial_id}
                </attribute>
            </xpath>
        </field>
    </record>

    <record id="brand_comercial_tours_crm_case_tree_view_oppor" model="ir.ui.view">
        <field name="name">brand.comercial.tours.crm.case.tree.view.oppor</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_case_tree_view_oppor"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='team_id']" position="before">
                <field name="brand_comercial_id"/>
            </xpath>
        </field>
    </record>

</odoo>
