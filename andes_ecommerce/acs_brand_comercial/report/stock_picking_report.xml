<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <template id="report_stock_picking_brand_comercial">
            <t t-call="acs_brand_comercial.external_layout_comercial_brand">
                <t t-set="doc" t-value="doc.with_context(lang=doc.partner_id.lang)" />
                <div class="page">
                    <div class="row">
                        <div class="col-6" name="div_outgoing_address">
                            <div t-if="doc.should_print_delivery_address()">
                                <span><strong>Delivery Address:</strong></span>
                                <div t-field="doc.move_ids[0].partner_id" t-options="{&quot;widget&quot;: &quot;contact&quot;, &quot;fields&quot;: [&quot;address&quot;, &quot;name&quot;, &quot;phone&quot;], &quot;no_marker&quot;: True, &quot;phone_icons&quot;: True}"/>
                            </div>
                            <div t-elif="doc.picking_type_id.code != 'internal' and doc.picking_type_id.warehouse_id.partner_id">
                                <span><strong>Warehouse Addres:</strong></span>
                                <div t-field="doc.picking_type_id.warehouse_id.partner_id" t-options="{&quot;widget&quot;: &quot;contact&quot;, &quot;fields&quot;: [&quot;address&quot;, &quot;name&quot;, &quot;phone&quot;], &quot;no_marker&quot;: True, &quot;phone_icons&quot;: True}"/>
                            </div>
                        </div>
                        <div class="col-5 offset-1" name="div_incoming_address">
                            <div t-if="doc.picking_type_id.code=='incoming' and doc.partner_id">
                                <span><strong>Vendor Address:</strong></span>
                            </div>
                            <div t-if="doc.picking_type_id.code=='internal' and doc.partner_id">
                                <span><strong>Warehouse Address:</strong></span>
                            </div>
                            <div t-if="doc.picking_type_id.code=='outgoing' and doc.partner_id">
                                <span><strong>Customer Address:</strong></span>
                            </div>
                            <div t-if="doc.partner_id" name="partner_header">
                                <div t-field="doc.partner_id" t-options="{&quot;widget&quot;: &quot;contact&quot;, &quot;fields&quot;: [&quot;address&quot;, &quot;name&quot;, &quot;phone&quot;, &quot;vat&quot;], &quot;no_marker&quot;: True, &quot;phone_icons&quot;: True}"/>
                            </div>
                        </div>
                    </div>
                    <br/>
                    <h1 t-field="doc.name" class="mt0"/>
                            <div class="row mt48 mb32">
                        <div t-if="doc.origin" class="col-auto" name="div_origin">
                            <strong>Order:</strong>
                            <p t-field="doc.origin"/>
                        </div>
                        <div class="col-auto" name="div_state">
                            <strong>Status:</strong>
                            <p t-field="doc.state"/>
                        </div>
                        <div class="col-auto" name="div_sched_date">
                            <strong>Scheduled Date:</strong>
                            <p t-field="doc.scheduled_date"/>
                        </div>
                    </div>
                    <table class="table table-sm" t-if="doc.move_line_ids and doc.move_ids_without_package">
                        <t t-set="has_barcode" t-value="any(move_line.product_id and move_line.product_id.sudo().barcode or move_line.package_id for move_line in doc.move_line_ids)"/>
                        <t t-set="has_serial_number" t-value="any(move_line.lot_id or move_line.lot_name for move_line in doc.move_line_ids)" groups="stock.group_production_lot"/>
                        <thead>
                            <tr>
                                <th name="th_product">
                                    <strong>Product</strong>
                                </th>
                                <th>
                                    <strong>Quantity</strong>
                                </th>
                                <th name="th_from" t-if="doc.picking_type_id.code != 'incoming'" align="left" groups="stock.group_stock_multi_locations">
                                    <strong>From</strong>
                                </th>
                                <th name="th_to" t-if="doc.picking_type_id.code != 'outgoing'" groups="stock.group_stock_multi_locations">
                                    <strong>To</strong>
                                </th>
                                <th name="th_serial_number" class="text-center" t-if="has_serial_number">
                                   <strong>Lot/Serial Number</strong>
                                </th>
                                <th name="th_barcode" class="text-center" t-if="has_barcode">
                                    <strong>Product Barcode</strong>
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            <!-- In case you come across duplicated lines, ask NIM or LAP -->
                            <t t-foreach="doc.move_line_ids_without_package" t-as="ml">
                                <tr>
                                    <td>
                                        <span t-field="ml.product_id.display_name"/><br/>
                                        <span t-field="ml.product_id.description_picking"/>
                                    </td>
                                    <td>
                                        <span t-if="doc.state != 'done'" t-field="ml.reserved_uom_qty"/>
                                        <span t-if="doc.state == 'done'" t-field="ml.qty_done"/>
                                        <span t-field="ml.product_uom_id" groups="uom.group_uom"/>
                                    </td>
                                    <td t-if="doc.picking_type_id.code != 'incoming'" groups="stock.group_stock_multi_locations">
                                        <span t-esc="ml.location_id.display_name"/>
                                            <t t-if="ml.package_id">
                                                <span t-field="ml.package_id"/>
                                            </t>
                                    </td>
                                    <td t-if="doc.picking_type_id.code != 'outgoing'" groups="stock.group_stock_multi_locations">
                                        <div>
                                            <span t-field="ml.location_dest_id"/>
                                            <t t-if="ml.result_package_id">
                                                <span t-field="ml.result_package_id"/>
                                            </t>
                                        </div>
                                    </td>
                                    <td class=" text-center h6" t-if="has_serial_number">
                                        <div t-if="has_serial_number and (ml.lot_id or ml.lot_name)" t-esc="ml.lot_id.name or ml.lot_name" t-options="{'widget': 'barcode', 'humanreadable': 1, 'width': 400, 'height': 100, 'img_style': 'width:100%;height:35px;'}"/>
                                    </td>
                                    <td class="text-center" t-if="has_barcode">
                                        <t t-if="product_barcode != ml.product_id.barcode">
                                            <span t-if="ml.product_id and ml.product_id.barcode">
                                                <div t-field="ml.product_id.barcode" t-options="{'widget': 'barcode', 'symbology': 'auto', 'width': 400, 'height': 100, 'quiet': 0, 'img_style': 'height:35px;'}"/>
                                            </span>
                                            <t t-set="product_barcode" t-value="ml.product_id.barcode"/>
                                        </t>
                                    </td>
                                </tr>
                            </t>
                          </tbody>
                    </table>
                    <table class="table table-sm" t-if="doc.package_level_ids and doc.picking_type_entire_packs and doc.state in ['assigned', 'done']">
                        <thead>
                            <tr>
                                <th name="th_package">Package</th>
                                <th name="th_pko_from" t-if="doc.picking_type_id.code != 'incoming'" groups="stock.group_stock_multi_locations">From</th>
                                <th name="th_pki_from" t-if="doc.picking_type_id.code != 'outgoing'" groups="stock.group_stock_multi_locations">To</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="doc.package_level_ids.sorted(key=lambda p: p.package_id.name)" t-as="package">
                                <t t-set="package" t-value="package.with_context(picking_id=doc.id)"/>
                                <td name="td_pk_barcode">
                                    <div t-field="package.package_id.name" t-options="{'widget': 'barcode', 'humanreadable': 1, 'width': 600, 'height': 100, 'img_style': 'width:300px;height:50px;margin-left: -50px;'}"/><br/>
                                </td>
                                <td t-if="doc.picking_type_id.code != 'incoming'" groups="stock.group_stock_multi_locations">
                                    <span t-field="package.location_id"/>
                                </td>
                                <td t-if="doc.picking_type_id.code != 'outgoing'" groups="stock.group_stock_multi_locations">
                                    <span t-field="package.location_dest_id"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                    <t t-set="no_reserved_product" t-value="doc.move_ids.filtered(lambda x: x.product_uom_qty != x.reserved_availability and x.move_line_ids and x.state!='done')"/>
                    <p t-if="doc.state in ['draft', 'waiting', 'confirmed'] or no_reserved_product"><i class="fa fa-exclamation-triangle"/>
                        All products could not be reserved. Click on the "Check Availability" button to try to reserve products.
                    </p>
                    <p t-field="doc.note"/>
                </div>
            </t>
        </template>

        <template id="report_stock_picking_brand">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="doc">
                    <t t-call="acs_brand_comercial.report_stock_picking_brand_comercial" t-lang="doc.partner_id.lang"/>
                </t>
            </t>
        </template>

        <report 
            id="stock_picking_brand_report"
            model="stock.picking"
            string="Por Marca"
            report_type="qweb-pdf"
            name="acs_brand_comercial.report_stock_picking_brand"
            file="acs_brand_comercial.report_stock_picking_brand"/>


    </data>
</odoo>
