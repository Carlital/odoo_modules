<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="mail_template_invoice_marca" model="mail.template">
            <field name="name">Invoice by brand</field>
            <field name="model_id" ref="account.model_account_move"/>
            <field name="subject">{{ object.company_id.name }} Invoice (Ref {{ object.name or 'n/a' }})</field>
            <field name="partner_to">{{ object.partner_id.id }}</field>
            <field name="description">Email for Invoice invoices by brand</field>
            <field name="auto_delete" eval="False"/>
            <!-- <field name="report_template_ids" eval="[(4, ref('acs_brand_comercial.account_invoice_contract'))]"/> -->
        </record>
    </data>
</odoo>