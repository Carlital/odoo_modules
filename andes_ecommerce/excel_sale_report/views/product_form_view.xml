<odoo>
    <record id="view_product_template_form_inherit_cod_producto" model="ir.ui.view">
        <field name="name">product.template.form.inherit.cod_producto</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='group_general']" position="inside">
                <field name="cod_producto" string="Product Code"/>
            </xpath>
        </field>
    </record>
    <record id="view_product_product_form_inherit_cod_producto" model="ir.ui.view">
        <field name="name">product.product.form.inherit.cod_producto</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='group_general']" position="inside">
                <field name="cod_producto" string="Product Code"/>
            </xpath>
        </field>
    </record>
</odoo>