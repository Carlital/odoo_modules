<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- Extender formulario de hr.employee para agregar Materias -->
    <record id="view_employee_form_cv_materias_inherit" model="ir.ui.view">
        <field name="name">hr.employee.form.cv.materias.inherit</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            
            <!-- Agregar botón estadístico para Materias -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_materias"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-book">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_value">
                            <field name="cv_materias_count"/>
                        </span>
                        <span class="o_stat_text">Materias</span>
                    </div>
                </button>
            </xpath>

            <!-- Agregar tab para Materias -->
            <xpath expr="//notebook" position="inside">
                <page string="Materias / Asignaturas" 
                      name="page_materias">
                    <field name="cv_materias_ids" 
                           context="{'default_employee_id': active_id}">
                        <tree editable="bottom">
                            <field name="asignatura"/>
                            <field name="course_code"/>
                            <field name="carrera_id"/>
                            <field name="facultad_id"/>
                            <field name="source" optional="hide"/>
                        </tree>
                    </field>
                    <group>
                        <div class="alert alert-info" role="alert" style="margin-top: 10px;">
                            <i class="fa fa-info-circle"/> 
                            <strong>Nota:</strong> Este es el modelo normalizado para materias y asignaturas impartidas.
                        </div>
                    </group>
                </page>
            </xpath>

        </field>
    </record>

</odoo>
