<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_invoice_excel_import_wizard_form" model="ir.ui.view">
        <field name="name">invoice.excel.import.wizard.form</field>
        <field name="model">invoice.excel.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Importar facturas desde Excel">
                <group>
                    <field name="template_id"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                    <field name="file_name" invisible="1"/>
                    <field name="file_data" filename="file_name"/>
                </group>
                <footer>
                    <button name="action_import" type="object" string="Importar" class="btn-primary"/>
                    <button string="Cancelar" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
