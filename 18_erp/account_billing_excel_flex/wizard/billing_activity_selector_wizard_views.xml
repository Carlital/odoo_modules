<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_billing_activity_selector_wizard_form" model="ir.ui.view">
        <field name="name">billing.activity.selector.wizard.form</field>
        <field name="model">billing.activity.selector.wizard</field>
        <field name="arch" type="xml">
            <form string="Seleccionar actividad visible">
                <group>
                    <field name="activity_id"/>
                </group>
                <footer>
                    <button name="action_apply" string="Aplicar" type="object" class="btn-primary"/>
                    <button string="Cancelar" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
