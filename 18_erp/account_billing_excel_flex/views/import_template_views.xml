<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_invoice_import_template_tree" model="ir.ui.view">
        <field name="name">account.invoice.import.template.tree</field>
        <field name="model">account.invoice.import.template</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="sheet_name"/>
                <field name="header_row"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_invoice_import_template_form" model="ir.ui.view">
        <field name="name">account.invoice.import.template.form</field>
        <field name="model">account.invoice.import.template</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="sheet_name"/>
                        <field name="header_row"/>
                        <field name="active"/>
                    </group>
                    <group string="Mapeo de columnas">
                        <field name="line_ids">
                            <list editable="bottom">
                                <field name="sequence"/>
                                <field name="excel_column"/>
                                <field name="target"/>
                            </list>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_invoice_import_template" model="ir.actions.act_window">
        <field name="name">Plantillas de importacion Excel</field>
        <field name="res_model">account.invoice.import.template</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
