<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit_activity" model="ir.ui.view">
        <field name="name">account.move.form.activity</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_date']" position="after">
                <field name="activity_id"/>
            </xpath>
        </field>
    </record>

    <record id="view_out_invoice_tree_inherit_activity" model="ir.ui.view">
        <field name="name">account.move.tree.activity</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_out_invoice_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <field name="activity_id" optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="view_account_invoice_filter_inherit_activity" model="ir.ui.view">
        <field name="name">account.move.search.activity.selector</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_invoice_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search/field[@name='partner_id']" position="after">
                <field name="activity_id" string="Actividad" filter_domain="[('activity_id', '=', self)]"/>
            </xpath>
            <xpath expr="//search" position="inside">
                <searchpanel>
                    <field name="activity_id" string="Actividad" enable_counters="1"/>
                </searchpanel>
            </xpath>
        </field>
    </record>
</odoo>
